      <div style="text-align: center;">
        <div class="invoice-header-badge">
          <span>✔</span> Order Confirmed &amp; Dispatched to Kitchen
        </div>
        <h3 class="modal-title" style="margin-bottom: 0.25rem;">Official Order Invoice</h3>
        <p class="modal-subtitle">Thank you for dining with BiteCraft Gourmet!</p>
      </div>

      <!-- Live Order Tracker -->
      <div class="invoice-tracker">
        <div class="tracker-step active">
          <div class="tracker-circle">1</div>
          <span>Placed</span>
        </div>
        <div class="tracker-step active">
          <div class="tracker-circle">2</div>
          <span>Kitchen</span>
        </div>
        <div class="tracker-step">
          <div class="tracker-circle">3</div>
