<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>BiteCraft Gourmet | Artisanal Food Ordering</title>
  <link rel="icon" type="image/png" href="logo.png">

  <!-- Modern Typography from Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap"
    rel="stylesheet">

  <!-- Lenis CSS for smooth scrolling structure -->
  <link rel="stylesheet" href="https://unpkg.com/@studio-freight/lenis@1.0.42/dist/lenis.css">

  <!-- Smooth Inertia Scroll: Lenis -->
  <script src="https://unpkg.com/lenis@1.1.18/dist/lenis.min.js"></script>

  <!-- GSAP & ScrollTrigger CDNs -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>

  <!-- Vanilla-Tilt CDN for 3D Card Effects -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/vanilla-tilt/1.8.1/vanilla-tilt.min.js"></script>

  <!-- AOS (Animate On Scroll) -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"></script>

  <style>
    /* ========================================================================= */
    /* DESIGN TOKENS & CSS VARIABLES                                             */
    /* ========================================================================= */
    :root {
      --primary: #00ff88;
      /* Vibrant electric neon green */
      --primary-hover: #00e67a;
      --primary-light: rgba(0, 255, 136, 0.12);

      --secondary: #00f5d4;
      /* Electric neon cyan / mint */
      --secondary-hover: #00d9bc;
      --secondary-light: rgba(0, 245, 212, 0.12);

      --accent: #10ff97;
      /* Bright cyber lime */
      --danger: #ff3860;
      /* Electric neon coral red */
      --danger-light: rgba(255, 56, 96, 0.14);

      --bg-dark: #060907;
      /* Ultra-deep obsidian black */
      --bg-surface: #0a110d;
      /* Sleek matte black surface */
      --bg-card: #0f1813;
      /* Elevated black card */
      --bg-card-hover: #14221a;
      --bg-input: #070c09;

      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --text-subtle: #64748b;

      --border-subtle: rgba(0, 255, 136, 0.1);
      --border-focus: rgba(0, 255, 136, 0.6);

      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 20px;
      --radius-xl: 28px;
      --radius-full: 9999px;

      --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.5);
      --shadow-md: 0 8px 24px rgba(0, 0, 0, 0.65);
      --shadow-lg: 0 16px 40px rgba(0, 0, 0, 0.85);
      --shadow-glow: 0 0 25px rgba(0, 255, 136, 0.35);

      --transition-fast: 0.18s cubic-bezier(0.4, 0, 0.2, 1);
      --transition-normal: 0.28s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* Base Reset & Lenis Inertia Configuration */
    html {
      scroll-behavior: auto;
    }

    html.lenis,
    html.lenis body {
      height: auto;
    }

    .lenis.lenis-smooth {
      scroll-behavior: auto !important;
    }

    .lenis.lenis-smooth [data-lenis-prevent] {
      overscroll-behavior: contain;
    }

    .lenis.lenis-stopped {
      overflow: hidden;
    }

    .lenis.lenis-scrolling iframe {
      pointer-events: none;
    }

    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
      background-color: var(--bg-dark);
      color: var(--text-main);
      line-height: 1.5;
      min-height: 100vh;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    /* ========================================================================= */
    /* LAYOUT & NAVBAR                                                           */
    /* ========================================================================= */
    .app-container {
      max-width: 1440px;
      margin: 0 auto;
      padding: 0 1.5rem 3rem;
    }

    header.navbar {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      z-index: 1000;
      background: rgba(10, 10, 10, 0.6);
      backdrop-filter: blur(12px) saturate(180%);
      -webkit-backdrop-filter: blur(12px) saturate(180%);
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      padding: 1rem 2rem;
      transition: background 0.4s cubic-bezier(0.4, 0, 0.2, 1),
        border-color 0.4s cubic-bezier(0.4, 0, 0.2, 1),
        box-shadow 0.4s cubic-bezier(0.4, 0, 0.2, 1),
        padding 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    header.navbar.scrolled {
      background: rgba(10, 10, 10, 0.76);
      backdrop-filter: blur(16px) saturate(190%);
      -webkit-backdrop-filter: blur(16px) saturate(190%);
      border-bottom: 1px solid rgba(0, 255, 136, 0.25);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.55);
      padding: 0.8rem 2rem;
    }

    .nav-inner {
      max-width: 1440px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
    }

    .brand-group {
      display: flex;
      align-items: center;
      gap: 0.85rem;
      text-decoration: none;
      color: inherit;
      cursor: pointer;
      filter: drop-shadow(0 2px 10px rgba(0, 0, 0, 0.85));
      transition: filter 0.3s ease;
    }

    .brand-icon {
      width: 44px;
      height: 44px;
      background: linear-gradient(135deg, rgba(0, 255, 136, 0.18), rgba(0, 245, 212, 0.28));
      border: 1px solid rgba(0, 255, 136, 0.4);
      border-radius: var(--radius-md);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.4rem;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.6), 0 0 18px rgba(0, 255, 136, 0.35);
      overflow: hidden;
      flex-shrink: 0;
    }

    .brand-logo-img {
      width: 32px;
      height: 32px;
      object-fit: contain;
      filter: drop-shadow(0 2px 5px rgba(0, 0, 0, 0.45));
    }

    .brand-text h1 {
      font-family: 'Playfair Display', serif;
      font-size: 1.4rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      background: linear-gradient(to right, #ffffff, #d1fae5);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      line-height: 1.1;
      text-shadow: 0 2px 10px rgba(0, 0, 0, 0.85);
    }

    .brand-text span {
      font-size: 0.75rem;
      color: var(--primary);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-weight: 700;
      text-shadow: 0 2px 8px rgba(0, 0, 0, 0.95);
    }

    .server-status-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: rgba(0, 255, 136, 0.1);
      border: 1px solid rgba(0, 255, 136, 0.3);
      padding: 0.35rem 0.85rem;
      border-radius: var(--radius-full);
      font-size: 0.78rem;
      color: var(--primary);
      font-weight: 600;
    }

    .pulse-dot {
      width: 8px;
      height: 8px;
      background: var(--primary);
      border-radius: 50%;
      box-shadow: 0 0 12px var(--primary);
      animation: pulse 1s infinite;
    }

    @keyframes pulse {
      0% {
        transform: scale(0.95);
        opacity: 0.8;
      }

      50% {
        transform: scale(1.35);
        opacity: 1;
      }

      100% {
        transform: scale(0.95);
        opacity: 0.8;
      }
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 0.65rem;
    }

    /* Common Base for All Navbar Action Buttons: Unified 42px Height & Pill Curvature */
    .nav-actions .btn-icon-outline,
    .nav-actions .btn-signup-pill,
    .nav-actions .btn-cart-toggle,
    .btn-nav-menu,
    .btn-nav-signin,
    .btn-nav-signup,
    .btn-nav-btn {
      height: 42px;
      padding: 0 1.25rem;
      border-radius: var(--radius-full);
      font-family: inherit;
      font-size: 0.88rem;
      font-weight: 700;
      letter-spacing: -0.01em;
      line-height: 1;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      white-space: nowrap;
      cursor: pointer;
      box-sizing: border-box;
      transition: all 0.22s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* Dedicated "Menu" Button: Frosted dark glass backing pill with subtle drop-shadow */
    .btn-nav-menu {
      background: rgba(10, 17, 13, 0.72);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.16);
      color: #ffffff;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.45);
      text-shadow: 0 1px 3px rgba(0, 0, 0, 0.85);
    }

    .btn-nav-menu:hover {
      background: rgba(18, 30, 23, 0.9);
      border-color: rgba(0, 255, 136, 0.5);
      color: var(--primary);
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.6), 0 0 16px rgba(0, 255, 136, 0.25);
      transform: translateY(-1px);
    }

    /* 1. Sign In Button: Sleek Translucent Glass Pill with soft protective backing */
    .nav-actions .btn-icon-outline,
    .btn-nav-signin {
      background: rgba(10, 17, 13, 0.72);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.16);
      color: #f1f5f9;
      font-weight: 600;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.45);
      text-shadow: 0 1px 3px rgba(0, 0, 0, 0.8);
    }

    .nav-actions .btn-icon-outline:hover,
    .btn-nav-signin:hover {
      background: rgba(20, 34, 26, 0.9);
      border-color: rgba(0, 255, 136, 0.45);
      color: #ffffff;
      transform: translateY(-1px);
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.6), 0 0 14px rgba(0, 255, 136, 0.25);
    }

    /* Fallback for generic btn-icon-outline outside navbar (e.g. receipt print) */
    .btn-icon-outline {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      color: var(--text-main);
      padding: 0.55rem 1rem;
      border-radius: var(--radius-md);
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      transition: var(--transition-fast);
    }

    .btn-icon-outline:hover {
      background: var(--bg-card);
      border-color: var(--primary);
      color: var(--primary);
    }

    /* 2. Sign Up Button: Matching 42px Vibrant Gourmet Pill with subtle drop-shadow */
    .btn-signup-pill,
    .btn-nav-signup {
      height: 42px;
      box-sizing: border-box;
      padding: 0 1.25rem;
      background: linear-gradient(135deg, var(--primary), var(--secondary));
      color: #040d07;
      border: 1px solid rgba(0, 255, 136, 0.6);
      border-radius: var(--radius-full);
      font-size: 0.88rem;
      font-weight: 700;
      letter-spacing: -0.01em;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.45rem;
      box-shadow: 0 4px 18px rgba(0, 0, 0, 0.55), 0 0 20px rgba(0, 255, 136, 0.4);
      transition: all 0.22s cubic-bezier(0.4, 0, 0.2, 1);
      white-space: nowrap;
    }

    .btn-signup-pill:hover,
    .btn-nav-signup:hover {
      transform: translateY(-1px);
      box-shadow: 0 6px 24px rgba(0, 0, 0, 0.65), 0 0 26px rgba(0, 255, 136, 0.65);
      filter: brightness(1.08);
    }

    /* 3. Cart Button: Matching 42px Hero CTA with Protective Drop-Shadow & Badge */
    .btn-cart-toggle {
      height: 42px;
      box-sizing: border-box;
      background: linear-gradient(135deg, var(--primary), var(--secondary));
      color: #040d07;
      border: 1px solid rgba(0, 255, 136, 0.6);
      padding: 0 1.15rem 0 1.25rem;
      border-radius: var(--radius-full);
      font-weight: 700;
      font-size: 0.88rem;
      letter-spacing: -0.01em;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.55rem;
      box-shadow: 0 4px 18px rgba(0, 0, 0, 0.55), 0 0 20px rgba(0, 255, 136, 0.4);
      transition: all 0.22s cubic-bezier(0.4, 0, 0.2, 1);
      white-space: nowrap;
    }

    .btn-cart-toggle:hover {
      transform: translateY(-1px);
      box-shadow: 0 6px 24px rgba(0, 0, 0, 0.65), 0 0 26px rgba(0, 255, 136, 0.65);
      filter: brightness(1.08);
    }

    .cart-badge {
      background: #040d07;
      color: var(--primary);
      font-size: 0.75rem;
      min-width: 22px;
      height: 22px;
      padding: 0 6px;
      border-radius: var(--radius-full);
      font-weight: 800;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      line-height: 1;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.4);
    }

    /* Auth & User Profile Navigation Styles: Soft backing pill with high contrast */
    .user-pill-container {
      display: flex;
      align-items: center;
      gap: 0.65rem;
    }

    .user-profile-pill {
      height: 42px;
      background: rgba(10, 17, 13, 0.75);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(0, 255, 136, 0.38);
      color: var(--text-main);
      padding: 0 1rem 0 0.5rem;
      border-radius: var(--radius-full);
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      cursor: pointer;
      box-shadow: 0 4px 18px rgba(0, 0, 0, 0.5);
      transition: all 0.22s cubic-bezier(0.4, 0, 0.2, 1);
      box-sizing: border-box;
      white-space: nowrap;
    }

    .user-profile-pill:hover {
      background: rgba(18, 30, 23, 0.92);
      border-color: var(--primary);
      box-shadow: 0 6px 22px rgba(0, 0, 0, 0.65), 0 0 18px rgba(0, 255, 136, 0.35);
      transform: translateY(-1px);
    }

    .user-avatar-circle {
      width: 30px;
      height: 30px;
      background: var(--primary-light);
      color: var(--primary);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.85rem;
      font-weight: 800;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.35);
    }

    .user-display-name {
      font-size: 0.88rem;
      font-weight: 700;
      color: #ffffff;
      text-shadow: 0 1px 4px rgba(0, 0, 0, 0.8);
    }

    .user-orders-tag {
      background: rgba(0, 245, 212, 0.16);
      color: var(--secondary);
      border: 1px solid rgba(0, 245, 212, 0.32);
      font-size: 0.72rem;
      font-weight: 800;
      padding: 0.2rem 0.55rem;
      border-radius: var(--radius-full);
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
      white-space: nowrap;
    }

    .btn-icon-square {
      background: rgba(10, 17, 13, 0.72);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.16);
      color: var(--text-muted);
      width: 42px;
      height: 42px;
      border-radius: var(--radius-full);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1rem;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.45);
      transition: all 0.22s cubic-bezier(0.4, 0, 0.2, 1);
      box-sizing: border-box;
    }

    .btn-icon-square:hover {
      background: var(--danger-light);
      color: var(--danger);
      border-color: var(--danger);
      box-shadow: 0 6px 20px rgba(255, 56, 96, 0.35);
      transform: translateY(-1px);
    }

    /* Auth Modal Tabs & Helpers */
    .auth-tabs {
      display: flex;
      background: var(--bg-card);
      border-radius: var(--radius-md);
      padding: 0.3rem;
      margin-bottom: 1.25rem;
      gap: 0.3rem;
      border: 1px solid var(--border-subtle);
    }

    .auth-tab-btn {
      flex: 1;
      background: transparent;
      border: none;
      color: var(--text-muted);
      padding: 0.6rem;
      border-radius: var(--radius-sm);
      font-size: 0.85rem;
      font-weight: 700;
      cursor: pointer;
      transition: var(--transition-fast);
    }

    .auth-tab-btn.active {
      background: var(--primary);
      color: #040d07;
      box-shadow: 0 0 12px rgba(0, 255, 136, 0.4);
    }



    /* User Orders Card Styles */
    .user-order-card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 1.25rem;
      margin-bottom: 1rem;
      transition: var(--transition-fast);
    }

    .user-order-card:hover {
      border-color: rgba(0, 255, 136, 0.35);
      box-shadow: 0 8px 24px rgba(0, 255, 136, 0.15);
    }

    .user-order-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.65rem;
      padding-bottom: 0.6rem;
      border-bottom: 1px solid var(--border-subtle);
    }

    .user-order-id {
      font-family: monospace;
      font-weight: 700;
      color: var(--primary);
      font-size: 0.95rem;
    }

    .user-order-status-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      background: rgba(16, 185, 129, 0.12);
      border: 1px solid rgba(16, 185, 129, 0.3);
      color: var(--secondary);
      padding: 0.2rem 0.65rem;
      border-radius: var(--radius-full);
      font-size: 0.72rem;
      font-weight: 800;
      text-transform: uppercase;
    }

    .user-order-details {
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-bottom: 0.75rem;
      line-height: 1.5;
    }

    .user-order-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: 0.65rem;
      border-top: 1px dashed var(--border-subtle);
    }

    .user-order-total {
      font-size: 1.05rem;
      font-weight: 800;
      color: #fff;
    }

    .user-order-total span {
      color: var(--primary);
    }

    /* ========================================================================= */
    /* BIO ANIMATIONS (SHARED)                                                   */
    /* ========================================================================= */
    .hero-tag {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      background: linear-gradient(135deg, rgba(0, 255, 136, 0.14), rgba(0, 245, 212, 0.22));
      border: 1px solid rgba(0, 255, 136, 0.45);
      color: #e6fffa;
      padding: 0.45rem 1.15rem;
      border-radius: var(--radius-full);
      font-size: 0.9rem;
      font-weight: 600;
      letter-spacing: 0.02em;
      margin-bottom: 1.15rem;
      box-shadow: 0 0 16px rgba(0, 255, 136, 0.22);
      position: relative;
      overflow: hidden;
      cursor: default;
      transition: all 0.3s ease;
      animation: bioGlowPulse 3s ease-in-out infinite alternate;
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
    }

    .hero-tag:hover {
      transform: translateY(-2px);
      border-color: rgba(0, 255, 136, 0.7);
      box-shadow: 0 0 24px rgba(0, 255, 136, 0.4);
    }

    .hero-tag::after {
      content: '';
      position: absolute;
      top: -50%;
      left: -60%;
      width: 40%;
      height: 200%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.35), transparent);
      transform: rotate(25deg);
      animation: bioShimmerSweep 4.5s ease-in-out infinite;
      pointer-events: none;
    }

    .bio-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 0.95rem;
      animation: bioHeartbeat 1.6s ease-in-out infinite;
      filter: drop-shadow(0 0 8px rgba(255, 75, 110, 0.7));
    }

    .bio-text {
      color: #ffffff;
      font-weight: 600;
      letter-spacing: 0.015em;
      text-shadow: 0 0 12px rgba(0, 255, 136, 0.3);
    }

    .bio-cursor {
      color: var(--primary);
      font-weight: 300;
      animation: bioCursorBlink 0.8s infinite;
      margin-left: -2px;
    }

    @keyframes bioCursorBlink {

      0%,
      100% {
        opacity: 1;
      }

      50% {
        opacity: 0;
      }
    }

    @keyframes bioHeartbeat {

      0%,
      100% {
        transform: scale(1);
      }

      14% {
        transform: scale(1.3) rotate(-5deg);
      }

      28% {
        transform: scale(1.05);
      }

      42% {
        transform: scale(1.22) rotate(4deg);
      }

      70% {
        transform: scale(1);
      }
    }

    @keyframes bioShimmerSweep {
      0% {
        left: -70%;
      }

      30% {
        left: 130%;
      }

      100% {
        left: 130%;
      }
    }

    @keyframes bioGlowPulse {
      0% {
        box-shadow: 0 0 12px rgba(0, 255, 136, 0.2), inset 0 0 10px rgba(0, 255, 136, 0.05);
        border-color: rgba(0, 255, 136, 0.35);
      }

      100% {
        box-shadow: 0 0 22px rgba(0, 255, 136, 0.42), 0 0 35px rgba(0, 245, 212, 0.2), inset 0 0 14px rgba(0, 245, 212, 0.1);
        border-color: rgba(0, 245, 212, 0.65);
      }
    }

    /* ========================================================================= */
    /* ZOMATO-STYLE FULLSCREEN HERO LANDING SECTION                              */
    /* ========================================================================= */
    .zomato-hero-section {
      position: relative;
      width: 100%;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 7rem 1.5rem 4.5rem;
      overflow: hidden;
      background-color: #060907;
      box-sizing: border-box;
    }

    .zomato-hero-bg {
      position: absolute;
      top: -4%;
      left: -4%;
      width: 108%;
      height: 108%;
      background-image:
        linear-gradient(180deg, rgba(6, 9, 7, 0.52) 0%, rgba(6, 9, 7, 0.72) 48%, rgba(6, 9, 7, 0.98) 100%),
        radial-gradient(ellipse at center, rgba(0, 0, 0, 0.28) 0%, rgba(6, 9, 7, 0.88) 85%),
        url('https://images.unsplash.com/photo-1513104890138-7c749659a591?w=1920&auto=format&fit=crop&q=80');
      background-size: cover;
      background-position: center center;
      background-repeat: no-repeat;
      transform: scale(1.02);
      animation: heroSlowZoom 24s ease-in-out infinite alternate;
      z-index: 1;
      pointer-events: none;
    }

    @keyframes heroSlowZoom {
      0% {
        transform: scale(1.02) translateY(0);
      }

      50% {
        transform: scale(1.07) translateY(-8px);
      }

      100% {
        transform: scale(1.02) translateY(0);
      }
    }

    .zomato-hero-content {
      position: relative;
      z-index: 2;
      max-width: 880px;
      margin: auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      animation: heroFadeIn 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    @keyframes heroFadeIn {
      from {
        opacity: 0;
        transform: translateY(24px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .zomato-brand-wrapper {
      display: inline-flex;
      align-items: center;
      gap: 0.9rem;
      margin-bottom: 0.65rem;
      cursor: pointer;
      user-select: none;
      transition: transform 0.25s ease;
    }

    .zomato-brand-wrapper:hover {
      transform: scale(1.03);
    }

    .zomato-hero-logo {
      width: 78px;
      height: 78px;
      object-fit: contain;
      filter: drop-shadow(0 10px 24px rgba(0, 0, 0, 0.7)) drop-shadow(0 0 28px rgba(0, 255, 136, 0.45));
      animation: heroLogoBob 3.2s ease-in-out infinite alternate;
    }

    @keyframes heroLogoBob {
      0% {
        transform: translateY(0) rotate(0deg);
      }

      100% {
        transform: translateY(-7px) rotate(2deg);
      }
    }

    .zomato-hero-brand-name {
      font-family: 'Playfair Display', serif;
      font-size: clamp(2.2rem, 4.5vw, 3.2rem);
      font-weight: 800;
      letter-spacing: -0.02em;
      color: #ffffff;
      line-height: 1;
      text-shadow: 0 4px 20px rgba(0, 0, 0, 0.85), 0 0 35px rgba(0, 255, 136, 0.3);
    }

    .zomato-hero-headline {
      font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
      font-size: clamp(2.5rem, 5.6vw, 4.6rem);
      font-weight: 800;
      color: #ffffff;
      line-height: 1.12;
      letter-spacing: -0.035em;
      margin: 0.6rem 0 1.35rem;
      text-shadow: 0 4px 35px rgba(0, 0, 0, 0.95);
      animation: headlineFloat 4s ease-in-out infinite alternate;
      cursor: default;
      user-select: none;
    }

    .headline-line-1 {
      display: inline-block;
      color: #ffffff;
      text-shadow: 0 4px 25px rgba(0, 0, 0, 0.9);
      transition: transform 0.3s ease;
    }

    .headline-line-2 {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      margin-top: 0.2rem;
    }

    .bite-accent {
      position: relative;
      display: inline-block;
      background: linear-gradient(110deg, #00ff88 0%, #00f5d4 25%, #ffffff 50%, #00f5d4 75%, #00ff88 100%);
      background-size: 200% 100%;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      animation: gradientShimmerWave 3.5s linear infinite;
      filter: drop-shadow(0 0 25px rgba(0, 255, 136, 0.55));
    }

    .bite-accent::after {
      content: '';
      position: absolute;
      bottom: 2px;
      left: 0;
      width: 100%;
      height: 4px;
      border-radius: var(--radius-full);
      background: linear-gradient(90deg, transparent 0%, #00ff88 25%, #00f5d4 75%, transparent 100%);
      box-shadow: 0 0 12px #00ff88, 0 0 20px #00f5d4;
      animation: underlinePulse 2.4s ease-in-out infinite alternate;
    }

    .headline-sparkle {
      display: inline-block;
      font-size: clamp(1.6rem, 3.2vw, 2.3rem);
      filter: drop-shadow(0 0 12px rgba(255, 215, 0, 0.85));
      animation: sparkleTwinkle 2.2s ease-in-out infinite alternate;
      line-height: 1;
      vertical-align: middle;
    }

    @keyframes gradientShimmerWave {
      0% {
        background-position: 200% 0;
      }

      100% {
        background-position: -200% 0;
      }
    }

    @keyframes headlineFloat {
      0% {
        transform: translateY(0);
        filter: drop-shadow(0 4px 30px rgba(0, 0, 0, 0.95)) drop-shadow(0 0 15px rgba(0, 255, 136, 0.2));
      }

      100% {
        transform: translateY(-6px);
        filter: drop-shadow(0 10px 40px rgba(0, 0, 0, 0.95)) drop-shadow(0 0 30px rgba(0, 255, 136, 0.45));
      }
    }

    @keyframes underlinePulse {
      0% {
        opacity: 0.5;
        transform: scaleX(0.85);
      }

      100% {
        opacity: 1;
        transform: scaleX(1.05);
      }
    }

    @keyframes sparkleTwinkle {
      0% {
        transform: scale(0.9) rotate(-8deg);
        filter: drop-shadow(0 0 6px rgba(255, 215, 0, 0.6));
      }

      100% {
        transform: scale(1.25) rotate(12deg);
        filter: drop-shadow(0 0 18px rgba(255, 215, 0, 1));
      }
    }

    .zomato-bio-tag {
      font-size: 0.98rem;
      padding: 0.5rem 1.3rem;
      margin-bottom: 1.25rem;
    }

    .zomato-hero-subtext {
      font-size: clamp(1.28rem, 2.8vw, 1.7rem);
      color: rgba(248, 250, 252, 0.96);
      font-weight: 600;
      max-width: 760px;
      line-height: 1.5;
      margin-bottom: 2.25rem;
      letter-spacing: -0.01em;
      text-shadow: 0 2px 16px rgba(0, 0, 0, 0.95);
    }

    .zomato-app-badges {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1.25rem;
      flex-wrap: wrap;
      margin-bottom: 1.6rem;
    }

    .zomato-store-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.85rem;
      background: rgba(10, 16, 12, 0.82);
      border: 1px solid rgba(255, 255, 255, 0.28);
      padding: 0.55rem 1.2rem;
      border-radius: var(--radius-md);
      color: #ffffff;
      text-decoration: none;
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.55);
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
      cursor: pointer;
      user-select: none;
    }

    .zomato-store-badge:hover {
      background: rgba(18, 28, 22, 0.95);
      border-color: rgba(0, 255, 136, 0.65);
      transform: translateY(-2px);
      box-shadow: 0 10px 28px rgba(0, 255, 136, 0.25), 0 8px 24px rgba(0, 0, 0, 0.6);
      color: #ffffff;
    }

    .zomato-store-badge svg {
      flex-shrink: 0;
    }

    .badge-texts {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      text-align: left;
    }

    .badge-sub {
      font-size: 0.65rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: rgba(255, 255, 255, 0.75);
      line-height: 1.1;
      font-weight: 600;
    }

    .badge-main {
      font-size: 1.12rem;
      font-weight: 700;
      color: #ffffff;
      line-height: 1.15;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    .zomato-cta-group {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1rem;
      flex-wrap: wrap;
      margin-bottom: 1.75rem;
    }

    .zomato-btn-primary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.65rem;
      background: linear-gradient(135deg, var(--primary), var(--secondary));
      color: #040d07;
      font-size: 1.05rem;
      font-weight: 800;
      letter-spacing: -0.01em;
      padding: 0.9rem 2.25rem;
      border-radius: var(--radius-full);
      border: 1px solid rgba(0, 255, 136, 0.6);
      box-shadow: 0 4px 25px rgba(0, 255, 136, 0.45);
      cursor: pointer;
      text-decoration: none;
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .zomato-btn-primary:hover {
      transform: translateY(-2px) scale(1.02);
      box-shadow: 0 8px 35px rgba(0, 255, 136, 0.65);
      filter: brightness(1.08);
      color: #040d07;
    }

    .zomato-trust-strip {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 1.25rem;
      background: rgba(0, 0, 0, 0.45);
      border: 1px solid rgba(255, 255, 255, 0.12);
      backdrop-filter: blur(8px);
      padding: 0.48rem 1.35rem;
      border-radius: var(--radius-full);
      font-size: 0.84rem;
      color: rgba(255, 255, 255, 0.88);
      font-weight: 600;
      margin-bottom: 0.75rem;
    }

    .zomato-trust-item {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
    }

    /* Scroll Down Bouncing Indicator (Distinctly separated with generous gap) */
    .zomato-scroll-down {
      position: relative;
      margin-top: 2.75rem;
      display: inline-flex;
      flex-direction: column;
      align-items: center;
      gap: 0.4rem;
      cursor: pointer;
      color: #f8fafc;
      text-decoration: none;
      user-select: none;
      padding: 0.45rem 1.25rem;
      border-radius: var(--radius-full);
      transition: all 0.25s ease;
      animation: zomatoBounce 2.1s cubic-bezier(0.28, 0.84, 0.42, 1) infinite;
    }

    .zomato-scroll-down:hover {
      color: var(--primary);
      background: rgba(255, 255, 255, 0.05);
    }

    .scroll-down-label {
      font-size: 0.92rem;
      font-weight: 600;
      letter-spacing: 0.03em;
      text-shadow: 0 2px 10px rgba(0, 0, 0, 0.9);
    }

    .scroll-arrow-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.9));
      transition: transform 0.2s ease;
    }

    .zomato-scroll-down:hover .scroll-arrow-icon {
      transform: translateY(3px);
    }

    @keyframes zomatoBounce {

      0%,
      20%,
      50%,
      80%,
      100% {
        transform: translateY(0);
      }

      40% {
        transform: translateY(8px);
      }

      60% {
        transform: translateY(3px);
      }
    }

    /* ========================================================================= */
    /* HENRIETTA-STYLE SCROLL PROGRESS BAR                                       */
    /* ========================================================================= */
    .scroll-progress-bar {
      position: fixed;
      top: 0;
      left: 0;
      width: 0%;
      height: 3px;
      background: linear-gradient(90deg, var(--primary), var(--secondary), #ffffff);
      z-index: 99999;
      box-shadow: 0 0 12px rgba(0, 255, 136, 0.8), 0 0 20px rgba(0, 245, 212, 0.6);
      transition: width 0.05s linear;
      pointer-events: none;
    }

    /* ========================================================================= */
    /* HENRIETTA-STYLE 3D FLOATING PARALLAX FOOD INGREDIENTS                     */
    /* ========================================================================= */
    .parallax-food-layer {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 2;
      overflow: hidden;
    }

    .parallax-food-item {
      position: absolute;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 68px;
      height: 68px;
      border-radius: 50%;
      background: radial-gradient(circle at 35% 35%, rgba(20, 35, 28, 0.7), rgba(8, 14, 11, 0.9));
      border: 1px solid rgba(0, 255, 136, 0.35);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.6), 0 0 25px rgba(0, 255, 136, 0.22);
      font-size: 2.1rem;
      user-select: none;
      will-change: transform;
      animation: floatIdle 6s ease-in-out infinite alternate;
      transition: filter 0.3s ease;
    }

    .parallax-food-item:hover {
      border-color: var(--primary);
      box-shadow: 0 15px 40px rgba(0, 0, 0, 0.7), 0 0 35px rgba(0, 255, 136, 0.45);
    }

    .item-1 {
      top: 12%;
      left: 5%;
      animation-delay: 0s;
      width: 72px;
      height: 72px;
      font-size: 2.2rem;
    }

    .item-2 {
      top: 16%;
      right: 6%;
      animation-delay: 1.4s;
      width: 76px;
      height: 76px;
      font-size: 2.4rem;
    }

    .item-3 {
      bottom: 18%;
      left: 6%;
      animation-delay: 2.5s;
      width: 68px;
      height: 68px;
      font-size: 2.1rem;
    }

    .item-4 {
      top: 52%;
      left: 3%;
      animation-delay: 0.8s;
      width: 56px;
      height: 56px;
      font-size: 1.7rem;
    }

    .item-5 {
      top: 48%;
      right: 3%;
      animation-delay: 3.2s;
      width: 62px;
      height: 62px;
      font-size: 1.9rem;
    }

    .item-6 {
      bottom: 12%;
      right: 7%;
      animation-delay: 1.9s;
      width: 72px;
      height: 72px;
      font-size: 2.2rem;
    }

    .item-7 {
      top: 7%;
      right: 26%;
      animation-delay: 0.5s;
      width: 50px;
      height: 50px;
      font-size: 1.5rem;
      background: rgba(0, 255, 136, 0.15);
      border-color: rgba(0, 255, 136, 0.5);
    }

    .item-8 {
      bottom: 32%;
      right: 20%;
      animation-delay: 2.1s;
      width: 54px;
      height: 54px;
      font-size: 1.6rem;
    }

    @keyframes floatIdle {
      0% {
        transform: translateY(0px) rotate(0deg);
      }

      50% {
        transform: translateY(-14px) rotate(6deg);
      }

      100% {
        transform: translateY(0px) rotate(0deg);
      }
    }

    /* ========================================================================= */
    /* HENRIETTA-STYLE RUNNING VELOCITY MARQUEE RIBBON                          */
    /* ========================================================================= */
    .henrietta-marquee-wrap {
      width: 100%;
      overflow: hidden;
      background: linear-gradient(90deg, #050e09 0%, #0d1e15 50%, #050e09 100%);
      border-top: 1px solid rgba(0, 255, 136, 0.3);
      border-bottom: 1px solid rgba(0, 255, 136, 0.3);
      padding: 1.25rem 0;
      position: relative;
      z-index: 25;
      box-shadow: 0 0 35px rgba(0, 255, 136, 0.14);
      transform: rotate(-0.85deg) scale(1.02);
      margin: -1rem 0 2.5rem;
    }

    .henrietta-marquee-wrap::before,
    .henrietta-marquee-wrap::after {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      width: 140px;
      z-index: 3;
      pointer-events: none;
    }

    .henrietta-marquee-wrap::before {
      left: 0;
      background: linear-gradient(90deg, var(--bg-dark), transparent);
    }

    .henrietta-marquee-wrap::after {
      right: 0;
      background: linear-gradient(270deg, var(--bg-dark), transparent);
    }

    .marquee-track {
      display: flex;
      width: max-content;
      animation: marqueeScroll 32s linear infinite;
      will-change: transform;
    }

    .henrietta-marquee-wrap:hover .marquee-track {
      animation-play-state: paused;
    }

    .marquee-content {
      display: flex;
      align-items: center;
      gap: 2.25rem;
      padding-right: 2.25rem;
      white-space: nowrap;
      font-size: 0.98rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #ffffff;
    }

    .marquee-content span {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      transition: all 0.2s ease;
    }

    .marquee-content span:hover {
      color: var(--primary);
      text-shadow: 0 0 14px rgba(0, 255, 136, 0.6);
    }

    .star-sep {
      color: var(--primary);
      font-size: 1.15rem;
      filter: drop-shadow(0 0 8px var(--primary));
    }

    @keyframes marqueeScroll {
      from {
        transform: translateX(0);
      }

      to {
        transform: translateX(-50%);
      }
    }

    /* ========================================================================= */
    /* BACK TO TOP FLOATING BUTTON                                               */
    /* ========================================================================= */
    .back-to-top-btn {
      position: fixed;
      bottom: 2rem;
      left: 2rem;
      right: auto;
      height: 44px;
      padding: 0 1.25rem 0 1rem;
      border-radius: var(--radius-full);
      background: rgba(10, 20, 15, 0.92);
      border: 1px solid rgba(0, 255, 136, 0.4);
      color: #ffffff;
      font-weight: 700;
      font-size: 0.88rem;
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      cursor: pointer;
      z-index: 450;
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.65), 0 0 20px rgba(0, 255, 136, 0.25);
      opacity: 0;
      visibility: hidden;
      transform: translateY(18px);
      transition: all 0.28s cubic-bezier(0.4, 0, 0.2, 1);
    }

    @media (max-width: 1024px) {
      .back-to-top-btn {
        left: auto;
        right: 1.5rem;
        bottom: 1.5rem;
        z-index: 400;
      }
    }

    .back-to-top-btn.visible {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .back-to-top-btn:hover {
      background: rgba(0, 255, 136, 0.18);
      border-color: var(--primary);
      color: var(--primary);
      transform: translateY(-3px);
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.75), 0 0 30px rgba(0, 255, 136, 0.5);
    }

    /* ========================================================================= */
    /* FOOD MENU SECTION                                                         */
    /* ========================================================================= */
    .menu-section {
      position: relative;
      width: 100%;
      padding-top: 3.5rem;
      background: var(--bg-dark);
      z-index: 20;
    }

    .menu-section-header {
      text-align: center;
      margin-bottom: 2.25rem;
    }

    .section-tag-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      background: rgba(0, 255, 136, 0.1);
      border: 1px solid rgba(0, 255, 136, 0.35);
      color: var(--primary);
      padding: 0.35rem 1rem;
      border-radius: var(--radius-full);
      font-size: 0.78rem;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      margin-bottom: 0.65rem;
    }

    .section-heading {
      font-family: 'Playfair Display', serif;
      font-size: clamp(2rem, 3.8vw, 2.75rem);
      font-weight: 700;
      color: #ffffff;
      line-height: 1.2;
      margin-bottom: 0.5rem;
    }

    .section-heading span {
      background: linear-gradient(to right, var(--primary), var(--secondary));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .section-subheading {
      color: var(--text-muted);
      font-size: 1.02rem;
      max-width: 580px;
      margin: 0 auto;
    }

    /* ========================================================================= */
    /* FILTER PILLS & SEARCH BAR                                                 */
    /* ========================================================================= */
    .controls-wrapper {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      margin-bottom: 2rem;
    }

    .category-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 0.65rem;
    }

    .pill-btn {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      color: var(--text-muted);
      padding: 0.55rem 1.25rem;
      border-radius: var(--radius-full);
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      transition: var(--transition-fast);
    }

    .pill-btn:hover {
      background: var(--bg-card);
      color: var(--text-main);
      border-color: rgba(255, 255, 255, 0.2);
    }

    .pill-btn.active {
      background: var(--primary);
      color: #040d07;
      border-color: var(--primary);
      font-weight: 700;
      box-shadow: 0 4px 18px rgba(0, 255, 136, 0.35);
    }

    .pill-btn.veg-filter-btn {
      border-color: rgba(0, 200, 83, 0.45);
      color: #00e676;
    }

    .pill-btn.veg-filter-btn:hover {
      background: rgba(0, 200, 83, 0.12);
      border-color: #00c853;
      color: #00ff88;
    }

    .pill-btn.veg-filter-btn.active {
      background: linear-gradient(135deg, #00c853, #00e676);
      color: #022610;
      border-color: #00e676;
      box-shadow: 0 4px 20px rgba(0, 230, 118, 0.45);
    }

    .search-box-wrap {
      position: relative;
      min-width: 280px;
    }

    .search-input {
      width: 100%;
      background: var(--bg-input);
      border: 1px solid var(--border-subtle);
      color: var(--text-main);
      padding: 0.65rem 1rem 0.65rem 2.5rem;
      border-radius: var(--radius-full);
      font-size: 0.88rem;
      outline: none;
      transition: var(--transition-fast);
    }

    .search-input:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(0, 255, 136, 0.25);
    }

    .search-icon {
      position: absolute;
      left: 0.9rem;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-subtle);
      font-size: 0.95rem;
      pointer-events: none;
    }

    /* ========================================================================= */
    /* MAIN CONTENT GRID & SIDEBAR CART                                          */
    /* ========================================================================= */
    .main-layout {
      display: grid;
      grid-template-columns: 1fr 380px;
      gap: 2rem;
      align-items: start;
    }

    /* Menu Cards Grid */
    .menu-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
      gap: 1.5rem;
    }

    /* Ensure smooth transitions for cards */
    .food-card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      position: relative;
      transform-style: preserve-3d;
      will-change: transform;
      transition: border-color 0.3s ease, box-shadow 0.3s ease, background 0.3s ease;
    }

    /* Floating food items have relative or absolute positioning for smooth parallax */
    .floating-food {
      will-change: transform;
    }

    .food-card:hover {
      border-color: #00ff88;
      box-shadow: 0 14px 35px rgba(0, 0, 0, 0.7), 0 0 25px rgba(0, 255, 136, 0.35);
      background: var(--bg-card-hover);
    }

    .card-media {
      position: relative;
      width: 100%;
      height: 185px;
      overflow: hidden;
      background: #090f0c;
    }

    .card-media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.4s ease;
    }

    .food-card:hover .card-media img {
      transform: scale(1.06);
    }

    .card-badge {
      position: absolute;
      top: 10px;
      left: 10px;
      background: rgba(6, 12, 9, 0.88);
      backdrop-filter: blur(8px);
      color: var(--primary);
      border: 1px solid rgba(0, 255, 136, 0.35);
      box-shadow: 0 0 10px rgba(0, 255, 136, 0.2);
      font-size: 0.72rem;
      font-weight: 700;
      padding: 0.25rem 0.65rem;
      border-radius: var(--radius-full);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .card-category-tag {
      position: absolute;
      top: 10px;
      right: 10px;
      background: rgba(16, 185, 129, 0.85);
      backdrop-filter: blur(8px);
      color: #022c22;
      font-size: 0.7rem;
      font-weight: 800;
      padding: 0.25rem 0.65rem;
      border-radius: var(--radius-full);
      text-transform: uppercase;
    }

    .card-body {
      padding: 1.25rem;
      display: flex;
      flex-direction: column;
      flex-grow: 1;
    }

    .card-title {
      font-size: 1.15rem;
      font-weight: 700;
      margin-bottom: 0.4rem;
      color: #fff;
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }

    /* Standard FSSAI Food Indicators */
    .veg-indicator {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 15px;
      height: 15px;
      border: 1.5px solid #00c853;
      border-radius: 3px;
      background: rgba(0, 200, 83, 0.08);
      vertical-align: middle;
      flex-shrink: 0;
    }

    .veg-indicator .dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #00c853;
      box-shadow: 0 0 6px rgba(0, 200, 83, 0.7);
    }

    .nonveg-indicator {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 15px;
      height: 15px;
      border: 1.5px solid #ef4444;
      border-radius: 3px;
      background: rgba(239, 68, 68, 0.08);
      vertical-align: middle;
      flex-shrink: 0;
    }

    .nonveg-indicator .dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #ef4444;
    }

    .card-desc {
      color: var(--text-muted);
      font-size: 0.85rem;
      line-height: 1.45;
      margin-bottom: 1.25rem;
      flex-grow: 1;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .card-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-top: 1px solid var(--border-subtle);
      padding-top: 1rem;
      margin-top: auto;
    }

    .card-price {
      font-size: 1.3rem;
      font-weight: 800;
      color: #fff;
    }

    .card-price span {
      font-size: 0.85rem;
      color: var(--primary);
      margin-right: 2px;
    }

    /* Add to Cart / Counter Button */
    .btn-add-cart {
      background: var(--primary);
      color: #040d07;
      border: none;
      padding: 0.55rem 1.1rem;
      border-radius: var(--radius-full);
      font-weight: 700;
      font-size: 0.85rem;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      box-shadow: 0 0 15px rgba(0, 255, 136, 0.3);
      transition: transform 0.15s ease, background 0.2s ease, box-shadow 0.2s ease;
    }

    .btn-add-cart:hover {
      background: var(--primary-hover);
      box-shadow: 0 0 20px rgba(0, 255, 136, 0.5);
      transform: scale(1.04);
    }

    .btn-add-cart:active {
      transform: scale(0.95);
      box-shadow: 0 0 10px rgba(0, 255, 136, 0.8);
    }

    .btn-add-cart.item-added-anim {
      background: #00f5d4;
      color: #040d07;
      transform: scale(0.96);
      box-shadow: 0 0 22px rgba(0, 245, 212, 0.85);
    }

    .qty-counter-pill {
      display: inline-flex;
      align-items: center;
      background: var(--bg-surface);
      border: 1px solid var(--primary);
      box-shadow: 0 0 10px rgba(0, 255, 136, 0.2);
      border-radius: var(--radius-full);
      overflow: hidden;
    }

    .qty-counter-btn {
      background: transparent;
      border: none;
      color: var(--primary);
      width: 32px;
      height: 32px;
      font-size: 1.1rem;
      font-weight: 800;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: var(--transition-fast);
    }

    .qty-counter-btn:hover {
      background: var(--primary);
      color: #040d07;
    }

    .qty-counter-num {
      padding: 0 0.5rem;
      font-size: 0.85rem;
      font-weight: 800;
      color: #fff;
      min-width: 20px;
      text-align: center;
    }

    /* ========================================================================= */
    /* STICKY CART SIDEBAR                                                       */
    /* ========================================================================= */
    .cart-sidebar {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-xl);
      padding: 1.25rem 1.25rem 1.35rem;
      position: sticky;
      top: 5.5rem;
      box-shadow: var(--shadow-md);
      display: flex;
      flex-direction: column;
      max-height: calc(100vh - 6.5rem);
      height: auto;
      box-sizing: border-box;
      overflow: hidden;
    }

    .cart-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-bottom: 0.65rem;
      border-bottom: 1px solid var(--border-subtle);
      margin-bottom: 0.65rem;
      flex-shrink: 0;
    }

    .cart-header h2 {
      font-size: 1.15rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .cart-clear-btn {
      background: transparent;
      border: none;
      color: var(--text-subtle);
      font-size: 0.76rem;
      cursor: pointer;
      font-weight: 600;
      transition: var(--transition-fast);
    }

    .cart-clear-btn:hover {
      color: var(--danger);
      text-decoration: underline;
    }

    /* Free Delivery Progress Bar */
    .delivery-progress-wrap {
      background: var(--bg-card);
      border-radius: var(--radius-md);
      padding: 0.55rem 0.85rem;
      margin-bottom: 0.65rem;
      border: 1px solid var(--border-subtle);
      flex-shrink: 0;
    }

    .delivery-progress-text {
      font-size: 0.76rem;
      color: var(--text-muted);
      margin-bottom: 0.35rem;
      display: flex;
      justify-content: space-between;
    }

    .delivery-progress-text strong {
      color: var(--secondary);
    }

    .delivery-bar-bg {
      width: 100%;
      height: 5px;
      background: rgba(255, 255, 255, 0.1);
      border-radius: var(--radius-full);
      overflow: hidden;
    }

    .delivery-bar-fill {
      height: 100%;
      background: linear-gradient(to right, var(--secondary), var(--primary));
      width: 0%;
      border-radius: var(--radius-full);
      box-shadow: 0 0 10px rgba(0, 255, 136, 0.5);
      transition: width 0.4s ease;
    }

    /* Items List Container */
    .cart-items-container {
      overflow-y: auto;
      flex: 1 1 auto;
      min-height: 80px;
      max-height: 320px;
      padding-right: 0.35rem;
      margin-bottom: 0.65rem;
    }

    .cart-items-container::-webkit-scrollbar {
      width: 4px;
    }

    .cart-items-container::-webkit-scrollbar-thumb {
      background: rgba(0, 255, 136, 0.25);
      border-radius: var(--radius-full);
    }

    .cart-items-container::-webkit-scrollbar-thumb:hover {
      background: rgba(0, 255, 136, 0.45);
    }

    .cart-empty-state {
      text-align: center;
      padding: 1.25rem 0.75rem;
      color: var(--text-muted);
    }

    .cart-empty-state .icon {
      font-size: 2.2rem;
      margin-bottom: 0.45rem;
      opacity: 0.7;
    }

    .cart-empty-state p {
      font-size: 0.88rem;
      font-weight: 600;
      color: #e5e7eb;
      margin-bottom: 0.25rem;
    }

    .cart-empty-state span {
      font-size: 0.75rem;
      color: var(--text-subtle);
      line-height: 1.4;
      display: block;
    }

    .cart-item-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.65rem;
      padding: 0.6rem 0;
      border-bottom: 1px solid var(--border-subtle);
      flex-shrink: 0;
    }

    .cart-item-info {
      flex-grow: 1;
      min-width: 0;
    }

    .cart-item-name {
      font-size: 0.88rem;
      font-weight: 600;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      color: #fff;
    }

    .cart-item-price {
      font-size: 0.78rem;
      color: var(--text-muted);
    }

    .cart-item-actions {
      display: flex;
      align-items: center;
      gap: 0.55rem;
    }

    .cart-item-subtotal {
      font-size: 0.9rem;
      font-weight: 700;
      color: #fff;
      min-width: 58px;
      text-align: right;
    }

    /* Cart Bill Summary */
    .cart-bill-summary {
      border-top: 1px solid var(--border-subtle);
      padding-top: 0.75rem;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      flex-shrink: 0;
    }

    .bill-row {
      display: flex;
      justify-content: space-between;
      font-size: 0.84rem;
      color: var(--text-muted);
    }

    .bill-row.grand-total {
      font-size: 1.15rem;
      font-weight: 800;
      color: #fff;
      padding-top: 0.65rem;
      padding-bottom: 0.35rem;
      border-top: 1px dashed var(--border-subtle);
      margin-top: 0.3rem;
      margin-bottom: 0.35rem;
    }

    .bill-row.grand-total .amount {
      color: var(--primary);
      font-size: 1.35rem;
    }

    .btn-checkout {
      width: 100%;
      background: linear-gradient(135deg, var(--primary), var(--secondary));
      color: #040d07;
      border: 1px solid transparent;
      padding: 0.82rem 1.25rem;
      border-radius: var(--radius-md);
      font-size: 0.96rem;
      font-weight: 800;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.6rem;
      box-shadow: 0 4px 18px rgba(0, 255, 136, 0.35);
      margin-top: 0.75rem;
      margin-bottom: 0.15rem;
      transition: var(--transition-fast);
      flex-shrink: 0;
    }

    .btn-checkout:hover:not(:disabled) {
      transform: translateY(-2px);
      box-shadow: 0 6px 25px rgba(0, 255, 136, 0.55);
    }

    .btn-checkout:disabled {
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.1);
      color: rgba(255, 255, 255, 0.38);
      box-shadow: none;
      cursor: not-allowed;
      filter: none;
      opacity: 1;
    }

    /* ========================================================================= */
    /* MODALS & OVERLAYS (Checkout, Invoice, Orders History)                      */
    /* ========================================================================= */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(4, 7, 13, 0.8);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      z-index: 1000;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.25s ease, visibility 0.25s ease;
    }

    .modal-backdrop.active {
      opacity: 1;
      visibility: visible;
    }

    .modal-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-xl);
      max-width: 580px;
      width: 100%;
      max-height: 90vh;
      overflow-y: auto;
      box-shadow: var(--shadow-lg);
      transform: translateY(20px) scale(0.97);
      transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      position: relative;
      padding: 2rem;
    }

    .modal-backdrop.active .modal-card {
      transform: translateY(0) scale(1);
    }

    .modal-close-btn {
      position: absolute;
      top: 1.25rem;
      right: 1.25rem;
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      color: var(--text-muted);
      width: 36px;
      height: 36px;
      border-radius: 50%;
      font-size: 1.1rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: var(--transition-fast);
    }

    .modal-close-btn:hover {
      background: var(--bg-card-hover);
      color: #fff;
    }

    .modal-header {
      margin-bottom: 1.5rem;
    }

    .modal-title {
      font-family: 'Playfair Display', serif;
      font-size: 1.6rem;
      font-weight: 700;
      color: #fff;
      margin-bottom: 0.35rem;
    }

    .modal-subtitle {
      font-size: 0.85rem;
      color: var(--text-muted);
    }

    /* Checkout Form Elements */
    .form-group {
      margin-bottom: 1.15rem;
    }

    .form-label {
      display: block;
      font-size: 0.82rem;
      font-weight: 700;
      color: var(--text-muted);
      margin-bottom: 0.4rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .form-input,
    .form-textarea {
      width: 100%;
      background: var(--bg-input);
      border: 1px solid var(--border-subtle);
      color: var(--text-main);
      padding: 0.75rem 1rem;
      border-radius: var(--radius-md);
      font-size: 0.9rem;
      font-family: inherit;
      outline: none;
      transition: var(--transition-fast);
    }

    .form-input:focus,
    .form-textarea:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(0, 255, 136, 0.25);
    }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }

    .payment-options {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.75rem;
      margin-bottom: 1.5rem;
    }

    .payment-option-card {
      background: var(--bg-input);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 0.85rem 0.5rem;
      text-align: center;
      cursor: pointer;
      font-size: 0.8rem;
      font-weight: 600;
      transition: var(--transition-fast);
    }

    .payment-option-card.active {
      border-color: var(--primary);
      background: var(--primary-light);
      color: var(--primary);
    }

    /* Invoice Receipt View */
    .invoice-header-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: rgba(16, 185, 129, 0.15);
      border: 1px solid rgba(16, 185, 129, 0.3);
      color: var(--secondary);
      padding: 0.4rem 1rem;
      border-radius: var(--radius-full);
      font-size: 0.85rem;
      font-weight: 700;
      margin-bottom: 1rem;
    }

    .invoice-id-box {
      background: var(--bg-card);
      border: 1px dashed var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 1rem;
      margin-bottom: 1.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .invoice-id-box strong {
      font-size: 1.1rem;
      color: var(--primary);
      font-family: monospace;
    }

    .invoice-items-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 1.5rem;
      font-size: 0.86rem;
    }

    .invoice-items-table th {
      text-align: left;
      padding: 0.6rem 0.5rem;
      border-bottom: 1px solid var(--border-subtle);
      color: var(--text-subtle);
      font-size: 0.75rem;
      text-transform: uppercase;
    }

    .invoice-items-table td {
      padding: 0.65rem 0.5rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    }

    .invoice-tracker {
      display: flex;
      justify-content: space-between;
      position: relative;
      margin: 1.75rem 0;
      padding: 0 1rem;
    }

    .invoice-tracker::before {
      content: '';
      position: absolute;
      top: 14px;
      left: 10%;
      right: 10%;
      height: 3px;
      background: rgba(255, 255, 255, 0.1);
      z-index: 1;
    }

    .tracker-step {
      position: relative;
      z-index: 2;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.72rem;
      color: var(--text-muted);
    }

    .tracker-circle {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: var(--bg-card);
      border: 2px solid var(--primary);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      color: var(--primary);
    }

    .tracker-step.active .tracker-circle {
      background: var(--primary);
      color: #040d07;
      box-shadow: 0 0 14px var(--primary);
    }

    /* Print Specific Styles */
    @media print {
      body * {
        visibility: hidden;
      }

      #invoiceModal,
      #invoiceModal * {
        visibility: visible;
      }

      #invoiceModal {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        background: #fff !important;
        color: #000 !important;
      }

      .modal-card {
        background: #fff !important;
        color: #000 !important;
        border: none !important;
        box-shadow: none !important;
      }

      .modal-close-btn,
      .btn-print,
      .btn-done {
        display: none !important;
      }
    }

    /* ========================================================================= */
    /* RESPONSIVE BREAKPOINTS                                                    */
    /* ========================================================================= */
    @media (max-width: 1024px) {
      .main-layout {
        grid-template-columns: 1fr;
      }

      .cart-sidebar {
        position: fixed;
        right: -100%;
        top: 0;
        bottom: 0;
        width: 360px;
        max-width: 90vw;
        max-height: 100vh;
        z-index: 500;
        border-radius: 0;
        transition: right 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      }

      .cart-sidebar.open {
        right: 0;
      }

      .cart-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.6);
        z-index: 499;
        display: none;
      }

      .cart-overlay.active {
        display: block;
      }
    }

    @media (max-width: 768px) {
      header.navbar {
        padding: 0.85rem 1.15rem;
      }

      header.navbar.scrolled {
        padding: 0.75rem 1.15rem;
      }

      .zomato-hero-section {
        padding: 5.5rem 1.25rem 3.5rem;
      }

      .zomato-hero-logo {
        width: 64px;
        height: 64px;
      }

      .zomato-hero-brand-name {
        font-size: 2.1rem;
      }

      .zomato-hero-headline {
        font-size: 2.15rem;
        line-height: 1.15;
      }

      .headline-sparkle {
        font-size: 1.35rem;
      }

      .zomato-bio-tag {
        font-size: 0.88rem;
        padding: 0.42rem 1.05rem;
      }

      .zomato-hero-subtext {
        font-size: 1.18rem;
        margin-bottom: 1.8rem;
      }

      .zomato-btn-primary {
        width: 100%;
        max-width: 320px;
        padding: 0.85rem 1.5rem;
      }

      .zomato-trust-strip {
        font-size: 0.75rem;
        gap: 0.65rem;
        padding: 0.35rem 0.85rem;
        flex-wrap: wrap;
      }

      .zomato-scroll-down {
        margin-top: 2rem;
      }

      .form-row {
        grid-template-columns: 1fr;
      }
    }

    /* ========================================================================= */
    /* ZOMATO-INSPIRED "BETTER FOOD FOR MORE PEOPLE" MISSION SECTION             */
    /* ========================================================================= */
    .zomato-mission-section {
      position: relative;
      background: #F9F6F0;
      color: #1a202c;
      padding: 7.5rem 1.5rem 8.5rem;
      overflow: hidden;
      border-top: 1px solid rgba(0, 0, 0, 0.06);
      border-bottom: 1px solid rgba(0, 0, 0, 0.06);
      box-shadow: inset 0 24px 36px -20px rgba(0, 0, 0, 0.08), inset 0 -24px 36px -20px rgba(0, 0, 0, 0.08);
    }

    .mission-inner-container {
      max-width: 1360px;
      min-height: 520px;
      margin: 0 auto;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* Animated Curved Vector Trails */
    .mission-trail-svg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 1;
    }

    .mission-trail-svg .trail-path {
      stroke-dasharray: 1600;
      stroke-dashoffset: 1600;
      animation: drawTrail 4s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }

    @keyframes drawTrail {
      to {
        stroke-dashoffset: 0;
      }
    }

    .mission-center-content {
      position: relative;
      z-index: 10;
      text-align: center;
      max-width: 620px;
      padding: 1.5rem;
      margin: 0 auto;
    }

    .mission-badge-pill {
      display: inline-block;
      background: rgba(226, 55, 68, 0.08);
      color: #e23744;
      border: 1px solid rgba(226, 55, 68, 0.22);
      padding: 0.38rem 1.1rem;
      border-radius: var(--radius-full);
      font-size: 0.78rem;
      font-weight: 800;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      margin-bottom: 1.25rem;
    }

    .mission-headline {
      font-family: 'Playfair Display', serif;
      font-size: clamp(2.5rem, 4.6vw, 3.9rem);
      font-weight: 800;
      color: #e23744;
      line-height: 1.15;
      letter-spacing: -0.02em;
      margin-bottom: 1.25rem;
      text-shadow: 0 2px 14px rgba(226, 55, 68, 0.08);
    }

    .mission-subtext {
      font-size: clamp(1.05rem, 1.4vw, 1.25rem);
      color: #4a5568;
      line-height: 1.65;
      max-width: 530px;
      margin: 0 auto 2.2rem;
      font-weight: 400;
    }

    .mission-explore-btn {
      background: #0a0f0d;
      color: #00ff88;
      border: 1.5px solid rgba(0, 255, 136, 0.5);
      padding: 0.95rem 2.4rem;
      border-radius: var(--radius-full);
      font-weight: 700;
      font-size: 0.98rem;
      letter-spacing: 0.01em;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.75rem;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.16), 0 0 20px rgba(0, 255, 136, 0.18);
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
      text-decoration: none;
    }

    .mission-explore-btn:hover {
      background: #0e1713;
      color: #ffffff;
      border-color: #00ff88;
      transform: translateY(-2px);
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.25), 0 0 32px rgba(0, 255, 136, 0.42);
    }

    .mission-explore-btn .btn-arrow {
      font-size: 1.15rem;
      color: #00ff88;
      transition: transform 0.25s ease, color 0.25s ease;
    }

    .mission-explore-btn:hover .btn-arrow {
      transform: translateY(3px);
      color: #ffffff;
    }
    

    /* Floating Food Elements Container */
    .mission-floating-foods {
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 4;
    }

    .floating-food-wrapper {
      position: absolute;
      pointer-events: auto;
      cursor: pointer;
      will-change: transform;
    }

    .food-img-card {
      position: relative;
      display: inline-block;
      transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .food-img-card img {
      display: block;
      width: 100%;
      height: auto;
      filter: drop-shadow(0 14px 22px rgba(0, 0, 0, 0.16));
      transition: filter 0.3s ease;
    }

    .floating-food-wrapper:hover .food-img-card {
      transform: scale(1.12) rotate(3deg);
    }

    .floating-food-wrapper:hover .food-img-card img {
      filter: drop-shadow(0 20px 30px rgba(239, 79, 95, 0.28));
    }

    /* Tooltip Badge on Hover */
    .food-tooltip {
      position: absolute;
      bottom: -32px;
      left: 50%;
      transform: translateX(-50%) translateY(8px);
      background: rgba(17, 24, 39, 0.92);
      color: #ffffff;
      font-size: 0.75rem;
      font-weight: 700;
      padding: 0.3rem 0.75rem;
      border-radius: var(--radius-full);
      white-space: nowrap;
      pointer-events: none;
      opacity: 0;
      visibility: hidden;
      transition: all 0.25s ease;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.25);
    }

    .floating-food-wrapper:hover .food-tooltip {
      opacity: 1;
      visibility: visible;
      transform: translateX(-50%) translateY(0);
    }

    /* Specific Placements & Dimensions */
    .food-burger {
      left: 7%;
      top: 48%;
      width: 185px;
      animation: floatBurger 6s ease-in-out infinite alternate;
    }

    .food-dimsum {
      right: 11%;
      top: 10%;
      width: 180px;
      animation: floatDimSum 6.5s ease-in-out infinite alternate;
    }

    .food-pizza {
      right: 9%;
      bottom: 12%;
      width: 180px;
      animation: floatPizza 5.8s ease-in-out infinite alternate;
    }

    .food-mint {
      left: 31%;
      top: 12%;
      width: 52px;
      animation: floatMint 5.2s ease-in-out infinite alternate;
    }

    .food-tomato-1 {
      left: 10%;
      bottom: 12%;
      width: 48px;
      animation: floatTomato1 6.8s ease-in-out infinite alternate;
    }

    .food-tomato-2 {
      right: 7%;
      top: 45%;
      width: 46px;
      animation: floatTomato2 5.5s ease-in-out infinite alternate;
    }

    /* Floating Keyframe Physics */
    @keyframes floatBurger {
      0% {
        transform: translateY(-8px) rotate(-2deg);
      }

      50% {
        transform: translateY(12px) rotate(3deg);
      }

      100% {
        transform: translateY(-8px) rotate(-2deg);
      }
    }

    @keyframes floatDimSum {
      0% {
        transform: translateY(10px) rotate(3deg);
      }

      50% {
        transform: translateY(-12px) rotate(-3deg);
      }

      100% {
        transform: translateY(10px) rotate(3deg);
      }
    }

    @keyframes floatPizza {
      0% {
        transform: translateY(-10px) rotate(-3deg);
      }

      50% {
        transform: translateY(12px) rotate(2deg);
      }

      100% {
        transform: translateY(-10px) rotate(-3deg);
      }
    }

    @keyframes floatMint {
      0% {
        transform: translateY(-6px) rotate(8deg);
      }

      50% {
        transform: translateY(8px) rotate(-10deg);
      }

      100% {
        transform: translateY(-6px) rotate(8deg);
      }
    }

    @keyframes floatTomato1 {
      0% {
        transform: translateY(8px) rotate(15deg);
      }

      50% {
        transform: translateY(-10px) rotate(-12deg);
      }

      100% {
        transform: translateY(8px) rotate(15deg);
      }
    }

    @keyframes floatTomato2 {
      0% {
        transform: translateY(-8px) rotate(-18deg);
      }

      50% {
        transform: translateY(10px) rotate(14deg);
      }

      100% {
        transform: translateY(-8px) rotate(-18deg);
      }
    }

    /* Responsive Tweaks for Mobile / Tablet */
    @media (max-width: 1024px) {
      .food-burger {
        width: 140px;
        left: 3%;
      }

      .food-dimsum {
        width: 135px;
        right: 5%;
        top: 6%;
      }

      .food-pizza {
        width: 135px;
        right: 4%;
        bottom: 8%;
      }
    }

    @media (max-width: 768px) {
      .zomato-mission-section {
        padding: 5rem 1.25rem 6rem;
      }

      .food-burger {
        width: 100px;
        left: 2%;
        top: 62%;
        opacity: 0.9;
      }

      .food-dimsum {
        width: 95px;
        right: 4%;
        top: 4%;
        opacity: 0.9;
      }

      .food-pizza {
        width: 95px;
        right: 3%;
        bottom: 4%;
        opacity: 0.9;
      }

      .food-mint {
        width: 36px;
        left: 20%;
        top: 6%;
      }

      .food-tomato-1 {
        display: none;
      }

      .food-tomato-2 {
        display: none;
      }
    }
  </style>
</head>

<body>

  <!-- Top Scroll Progress Bar (Henrietta effect) -->
  <div class="scroll-progress-bar" id="scrollProgressBar"></div>

  <!-- Background overlay for mobile cart drawer -->
  <div class="cart-overlay" id="cartOverlay" onclick="toggleCartDrawer()"></div>

  <!-- ===================================================================== -->
  <!-- TOP NAVIGATION BAR (Fixed Glassmorphism Navbar)                        -->
  <!-- ===================================================================== -->
  <header class="navbar" id="topNavbar">
    <div class="nav-inner">
      <div class="brand-group" onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
        title="BiteCraft Gourmet Kitchen">
        <div class="brand-icon">
          <img src="logo.png" alt="BiteCraft Logo" class="brand-logo-img">
        </div>
        <div class="brand-text">
          <h1>BiteCraft</h1>
          <span>Gourmet Kitchen</span>
        </div>
      </div>

      <div class="nav-actions">
        <!-- Quick Explore Menu button in Navbar -->
        <button class="btn-nav-menu" onclick="scrollToMenu()" title="Explore food menu items">
          <span>🍽️</span> <span>Menu</span>
        </button>

        <!-- Dynamic Auth Container (Sign In / Sign Up OR User Profile Pill) -->
        <div id="authNavContainer" style="display: flex; align-items: center; gap: 0.65rem;">
          <!-- Rendered dynamically by renderAuthUI() -->
        </div>

        <button class="btn-cart-toggle" onclick="toggleCartDrawer()">
          <span>🛒</span> <span>Cart</span>
          <span class="cart-badge" id="navCartCount">0</span>
        </button>
      </div>
    </div>
  </header>

  <!-- ===================================================================== -->
  <!-- FULLSCREEN ZOMATO-STYLE LANDING PAGE                                 -->
  <!-- ===================================================================== -->
  <section class="zomato-hero-section" id="landingHero">
    <!-- Cinematic Food Background with smooth zoom animation -->
    <div class="zomato-hero-bg"></div>

    <!-- Henrietta-Style 3D Floating Parallax Food Elements -->
    <div class="parallax-food-layer" id="parallaxFoodLayer">
      <div class="parallax-food-item floating-food item-1" data-speed="0.32" data-rotate="18" title="Truffle Burger">
        <span>🍔</span>
      </div>
      <div class="parallax-food-item floating-food item-2" data-speed="-0.38" data-rotate="-22" title="Artisan Pizza">
        <span>🍕</span>
      </div>
      <div class="parallax-food-item floating-food item-3" data-speed="0.44" data-rotate="24" title="Crispy Fries">
        <span>🍟</span>
      </div>
      <div class="parallax-food-item floating-food item-4" data-speed="-0.25" data-rotate="-16" title="Fresh Basil">
        <span>🌿</span>
      </div>
      <div class="parallax-food-item floating-food item-5" data-speed="0.36" data-rotate="28" title="Organic Tomato">
        <span>🍅</span>
      </div>
      <div class="parallax-food-item floating-food item-6" data-speed="-0.42" data-rotate="-24" title="Aged Cheddar">
        <span>🧀</span>
      </div>
      <div class="parallax-food-item floating-food item-7" data-speed="0.5" data-rotate="40" title="Gourmet Sparkle">
        <span>✨</span>
      </div>
      <div class="parallax-food-item floating-food item-8" data-speed="-0.28" data-rotate="15" title="Chili Spice">
        <span>🌶️</span>
      </div>
    </div>

    <div class="zomato-hero-content">
      <!-- Centered Brand Logo & Title -->
      <div class="zomato-brand-wrapper" onclick="window.scrollTo({ top: 0, behavior: 'smooth' })">
        <img src="logo.png" alt="BiteCraft Emblem" class="zomato-hero-logo">
        <span class="zomato-hero-brand-name">BiteCraft</span>
      </div>

      <!-- Main Animated Eye-Catchy Headline -->
      <h1 class="zomato-hero-headline animated-hero-headline">
        <span class="headline-line-1">Delivering delicious moments,</span><br>
        <span class="headline-line-2">
          <span class="bite-accent">bite by bite.</span>
          <span class="headline-sparkle">✨</span>
        </span>
      </h1>

      <!-- Subtitle description (enlarged text directly above action button) -->
      <p class="zomato-hero-subtext">
        Experience fast &amp; easy online ordering on BiteCraft
      </p>

      <!-- Action Button & Trust Highlights -->
      <div class="zomato-cta-group">
        <button class="zomato-btn-primary" onclick="scrollToMenu()">
          <span>🍽️ Explore Menu &amp; Order</span>
          <span style="font-size: 1.2rem; line-height: 1;">&darr;</span>
        </button>
      </div>

      <div class="zomato-trust-strip">
        <span class="zomato-trust-item">⚡ 25-35 Min Delivery</span>
        <span>•</span>
        <span class="zomato-trust-item">🌟 4.9 Star Rating</span>
        <span>•</span>
        <span class="zomato-trust-item">🛡️ 100% Contactless</span>
      </div>

      <!-- Bouncing "Scroll down ︾" indicator with clean separation -->
      <div class="zomato-scroll-down" onclick="scrollToMenu()" role="button" aria-label="Scroll down to food menu">
        <span class="scroll-down-label">Scroll down</span>
        <div class="scroll-arrow-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"
            stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- HENRIETTA-STYLE RUNNING VELOCITY MARQUEE RIBBON                       -->
  <!-- ===================================================================== -->
  <div class="henrietta-marquee-wrap" id="marqueeRibbon">
    <div class="marquee-track" id="marqueeTrack">
      <div class="marquee-content">
        <span>⚡ ARTISANAL CHEF KITCHEN</span>
        <span class="star-sep">✦</span>
        <span>🍕 HANDCRAFTED GOURMET PIZZAS</span>
        <span class="star-sep">✦</span>
        <span>🍔 TRUFFLE SMASH BURGERS</span>
        <span class="star-sep">✦</span>
        <span>🚀 25-35 MIN EXPRESS DELIVERY</span>
        <span class="star-sep">✦</span>
        <span>🌿 100% ORGANIC FARM INGREDIENTS</span>
        <span class="star-sep">✦</span>
        <span>🍹 REFRESHING ARTISANAL DRINKS</span>
        <span class="star-sep">✦</span>
        <span>✨ PURE PASSION IN EVERY BITE</span>
        <span class="star-sep">✦</span>
      </div>
      <div class="marquee-content" aria-hidden="true">
        <span>⚡ ARTISANAL CHEF KITCHEN</span>
        <span class="star-sep">✦</span>
        <span>🍕 HANDCRAFTED GOURMET PIZZAS</span>
        <span class="star-sep">✦</span>
        <span>🍔 TRUFFLE SMASH BURGERS</span>
        <span class="star-sep">✦</span>
        <span>🚀 25-35 MIN EXPRESS DELIVERY</span>
        <span class="star-sep">✦</span>
        <span>🌿 100% ORGANIC FARM INGREDIENTS</span>
        <span class="star-sep">✦</span>
        <span>🍹 REFRESHING ARTISANAL DRINKS</span>
        <span class="star-sep">✦</span>
        <span>✨ PURE PASSION IN EVERY BITE</span>
        <span class="star-sep">✦</span>
      </div>
    </div>
  </div>

  <!-- ===================================================================== -->
  <!-- "BETTER FOOD FOR MORE PEOPLE" MISSION SHOWCASE SECTION                -->
  <!-- ===================================================================== -->
  <section class="zomato-mission-section" id="missionSection">
    <div class="mission-inner-container">

      <!-- Delicate Winding Vector Pink Trail (Animated SVG Lines routed cleanly around central typography) -->
      <svg class="mission-trail-svg" viewBox="0 0 1200 600" fill="none" xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true">
        <path class="trail-path"
          d="M 50,45 C 150,15 220,120 170,260 C 120,400 60,460 110,540 C 160,610 320,560 490,545 C 680,530 810,540 910,510 C 1010,480 1120,380 1140,240 C 1160,110 1060,50 960,65 C 860,80 840,40 760,35"
          stroke="#ff758c" stroke-width="1.8" stroke-linecap="round" opacity="0.35" />
        <path class="trail-path"
          d="M 20,240 C 100,160 180,60 320,45 C 440,30 520,30 640,30 C 780,30 920,50 1020,110 C 1120,170 1180,320 1060,440 C 960,540 820,560 660,555"
          stroke="#ff99a6" stroke-width="1.4" stroke-dasharray="8 6" stroke-linecap="round" opacity="0.3" />
      </svg>

      <!-- Center Text Headline & Mission Statement -->
      <div class="mission-center-content animate-on-scroll">
        <span class="mission-badge-pill">OUR CULINARY MISSION</span>
        <h2 class="mission-headline">Better food for<br>more people</h2>
        <p class="mission-subtext">
          For over a decade, we’ve enabled our customers to discover new tastes, delivered right to their doorstep.
        </p>
        <div class="mission-cta-wrap">
          <button class="mission-explore-btn" onclick="scrollToMenu()">
            <span>Explore Menu &amp; Order</span>
            <span class="btn-arrow">&darr;</span>
          </button>
        </div>
      </div>

      <!-- Floating 3D Food Elements (Burger, Dim Sum, Pizza, Mint, Tomatoes) -->
      <div class="mission-floating-foods" aria-hidden="true">
        <!-- 1. Gourmet Stacked Burger (Left) -->
        <div class="floating-food-wrapper food-burger" data-speed="0.45" data-rotate="-16" title="Gourmet Smash Burger">
          <div class="food-img-card">
            <img src="/assets/mission/burger.png" class="floating-food burger-left" alt="Gourmet Burger" loading="lazy">
            <span class="food-tooltip">🍔 Gourmet Burger</span>
          </div>
        </div>

        <!-- 2. Steamed Dim Sum in Bamboo Basket (Top Right) -->
        <div class="floating-food-wrapper food-dimsum" data-speed="-0.48" data-rotate="20"
          title="Artisan Steamed Dim Sum">
          <div class="food-img-card">
            <img src="/assets/mission/dimsum.png" class="floating-food dimsum-top" alt="Dim Sum Dumplings" loading="lazy">
            <span class="food-tooltip">🥟 Steamed Dim Sum</span>
          </div>
        </div>

        <!-- 3. Cheesy Artisan Pizza Slice (Bottom Right) -->
        <div class="floating-food-wrapper food-pizza" data-speed="0.52" data-rotate="-22"
          title="Stone-Baked Pizza Slice">
          <div class="food-img-card">
            <img src="/assets/mission/pizza.png" class="floating-food pizza-right" alt="Pizza Slice" loading="lazy">
            <span class="food-tooltip">🍕 Stone-Baked Pizza</span>
          </div>
        </div>

        <!-- 4. Fresh Garden Mint Leaf (Top Center/Left) -->
        <div class="floating-food-wrapper food-mint" data-speed="-0.32" data-rotate="30" title="Organic Mint Leaf">
          <div class="food-img-card">
            <img src="/assets/mission/mint.png" class="floating-food mint-top" alt="Fresh Mint" loading="lazy">
          </div>
        </div>

        <!-- 5. Sun-Ripened Tomato Slice (Bottom Left) -->
        <div class="floating-food-wrapper food-tomato-1" data-speed="0.62" data-rotate="-28"
          title="Organic Tomato Slice">
          <div class="food-img-card">
            <img src="/assets/mission/tomato.png" class="floating-food tomato-bottom" alt="Tomato Slice" loading="lazy">
          </div>
        </div>

        <!-- 6. Tomato Slice (Mid Right) -->
        <div class="floating-food-wrapper food-tomato-2" data-speed="-0.42" data-rotate="24" title="Ripe Tomato">
          <div class="food-img-card">
            <img src="/assets/mission/tomato2.png" class="floating-food tomato-mid" alt="Tomato Slice" loading="lazy">
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- FOOD CATALOG & ORDERING SECTION                                       -->
  <!-- ===================================================================== -->
  <section class="menu-section" id="menuSection">
    <div class="app-container">

      <!-- Section Intro Header -->
      <div class="menu-section-header animate-on-scroll">
        <div class="section-tag-pill">✨ ARTISANAL DISHES</div>
        <h2 class="section-heading">Handcrafted <span>Gourmet Delights</span></h2>
        <p class="section-subheading">Crafted live by artisanal chefs with organic farm ingredients, delivered hot in 30
          minutes</p>
      </div>

      <!-- Controls: Category Filter & Search -->
      <div class="controls-wrapper animate-on-scroll">
        <div class="category-pills" id="categoryContainer">
          <button class="pill-btn active" onclick="filterCategory('All')">✨ All Items</button>
          <button class="pill-btn veg-filter-btn" onclick="filterCategory('Pure Veg')">🌱 Pure Veg</button>
          <button class="pill-btn" onclick="filterCategory('Fast Food')">🍔 Fast Food</button>
          <button class="pill-btn" onclick="filterCategory('Main Course')">🍝 Main Course</button>
          <button class="pill-btn" onclick="filterCategory('Beverages')">🍹 Beverages</button>
          <button class="pill-btn" onclick="filterCategory('Desserts')">🍰 Desserts</button>
        </div>

        <div class="search-box-wrap">
          <span class="search-icon">🔍</span>
          <input type="text" id="searchInput" class="search-input" placeholder="Search dishes, ingredients..."
            oninput="handleSearch()">
        </div>
      </div>

      <!-- ===================================================================== -->
      <!-- MAIN GRID & CART SIDEBAR                                              -->
      <!-- ===================================================================== -->
      <div class="main-layout">

        <!-- Food Menu Grid -->
        <main>
          <div class="menu-grid" id="menuGrid">
            <!-- Food cards dynamically injected from server JSON -->
          </div>
        </main>

        <!-- Sticky Cart Sidebar -->
        <aside class="cart-sidebar animate-on-scroll" id="cartSidebar">
          <div class="cart-header">
            <h2>🛒 Your Order</h2>
            <button class="cart-clear-btn" onclick="clearCart()">Clear All</button>
          </div>

          <!-- Free Delivery Progress Bar -->
          <div class="delivery-progress-wrap">
            <div class="delivery-progress-text">
              <span id="deliveryProgressMsg">Add ₹199.00 for FREE Delivery</span>
              <strong id="deliveryProgressPct">0%</strong>
            </div>
            <div class="delivery-bar-bg">
              <div class="delivery-bar-fill" id="deliveryProgressBar"></div>
            </div>
          </div>

          <!-- Cart Items List -->
          <div class="cart-items-container" id="cartItemsList">
            <div class="cart-empty-state">
              <div class="icon">🍽️</div>
              <p>Your cart is empty.</p>
              <span style="font-size: 0.78rem; color: var(--text-subtle);">Select mouth-watering items from the menu to
                get started!</span>
            </div>
          </div>

          <!-- Cart Financial Totals -->
          <div class="cart-bill-summary">
            <div class="bill-row">
              <span>Items Subtotal</span>
              <span id="cartSubtotal">₹0.00</span>
            </div>
            <div class="bill-row">
              <span>Estimated GST (5%)</span>
              <span id="cartTax">₹0.00</span>
            </div>
            <div class="bill-row">
              <span>Delivery Fee</span>
              <span id="cartDelivery">₹0.00</span>
            </div>
            <div class="bill-row grand-total">
              <span>Grand Total</span>
              <span class="amount" id="cartGrandTotal">₹0.00</span>
            </div>

            <button class="btn-checkout" id="checkoutBtn" onclick="openCheckoutModal()" disabled>
              <span>Proceed to Checkout</span>
              <span>&rarr;</span>
            </button>
          </div>
        </aside>

      </div>

    </div>
  </section>

  <!-- Floating Back to Top Button -->
  <button class="back-to-top-btn" id="backToTopBtn" onclick="scrollToTop()" title="Back to top"
    aria-label="Back to top">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"
      stroke-linecap="round" stroke-linejoin="round">
      <polyline points="18 15 12 9 6 15"></polyline>
    </svg>
    <span>Top</span>
  </button>

  <!-- ======================================================================= -->
  <!-- CHECKOUT MODAL                                                          -->
  <!-- ======================================================================= -->
  <div class="modal-backdrop" id="checkoutModal">
    <div class="modal-card">
      <button class="modal-close-btn" onclick="closeModal('checkoutModal')">&times;</button>

      <div class="modal-header">
        <h3 class="modal-title">Complete Your Order</h3>
        <p class="modal-subtitle">Provide your delivery details so our kitchen can dispatch promptly.</p>
      </div>

      <form id="checkoutForm" onsubmit="submitOrder(event)">
        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="custName">Full Name *</label>
            <input type="text" id="custName" class="form-input" placeholder="e.g. Alexander Wright" required>
          </div>
          <div class="form-group">
            <label class="form-label" for="custPhone">Phone Number *</label>
            <input type="tel" id="custPhone" class="form-input" placeholder="e.g. +1 (555) 234-5678" required>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="custAddress">Delivery Address *</label>
          <input type="text" id="custAddress" class="form-input" placeholder="Street address, apartment, suite, city"
            required>
        </div>

        <div class="form-group">
          <label class="form-label" for="custNotes">Special Instructions (Optional)</label>
          <textarea id="custNotes" class="form-textarea" rows="2"
            placeholder="e.g. Gate code #402, extra napkins, contact-free delivery"></textarea>
        </div>

        <label class="form-label">Payment Method</label>
        <div class="payment-options">
          <div class="payment-option-card active" onclick="selectPayment(this, 'COD')">
            💵 Cash on Delivery
          </div>
          <div class="payment-option-card" onclick="selectPayment(this, 'Card')">
            💳 Credit / Debit Card
          </div>
          <div class="payment-option-card" onclick="selectPayment(this, 'UPI')">
            📱 UPI / Instant
          </div>
        </div>

        <div
          style="background: var(--bg-card); padding: 1rem; border-radius: var(--radius-md); margin-bottom: 1.25rem; font-size: 0.88rem; display: flex; justify-content: space-between; align-items: center;">
          <span>Payable Amount:</span>
          <strong style="font-size: 1.25rem; color: var(--primary);" id="modalPayableTotal">₹0.00</strong>
        </div>

        <button type="submit" class="btn-checkout" id="submitOrderBtn">
          <span>Confirm & Place Order</span>
          <span>⚡</span>
        </button>
      </form>
    </div>
  </div>

  <!-- ======================================================================= -->
