      <!-- Alert Banner -->
      <div id="authAlertBanner"
        style="display: none; padding: 0.75rem 1rem; border-radius: var(--radius-md); font-size: 0.85rem; margin-bottom: 1.25rem;">
      </div>

      <!-- Sign In Form -->
      <form id="loginForm" onsubmit="handleLoginSubmit(event)">
        <div class="form-group">
          <label class="form-label" for="loginUsername">Username *</label>
          <input type="text" id="loginUsername" class="form-input" placeholder="e.g. alex" required
            autocomplete="username">
