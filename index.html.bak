    /**
     * Helper to identify pure vegetarian items
     */
    function isItemVegetarian(item) {
      const nonVegIds = [1, 3, 5, 6];
      if (nonVegIds.includes(item.id)) return false;
      const text = ((item.name || '') + ' ' + (item.description || '')).toLowerCase();
      if (text.includes('beef') || text.includes('salmon') || text.includes('wings') || text.includes('carne asada')) {
        return false;
      }
      return true;
    }

    /**
     * Renders menu cards based on active category and search filter
     */
    function renderMenu() {
      const grid = document.getElementById('menuGrid');
      grid.innerHTML = '';

      const filtered = menuItems.filter(item => {
        let matchesCategory = false;
        if (currentCategory === 'All') {
          matchesCategory = true;
        } else if (currentCategory === 'Pure Veg') {
          matchesCategory = isItemVegetarian(item);
        } else {
          matchesCategory = (item.category === currentCategory);
        }

        const matchesSearch = item.name.toLowerCase().includes(searchQuery.toLowerCase()) ||
          item.description.toLowerCase().includes(searchQuery.toLowerCase());
        return matchesCategory && matchesSearch;
      });

      if (filtered.length === 0) {
        grid.innerHTML = `
          <div style="grid-column: 1 / -1; text-align: center; padding: 4rem 1rem; color: var(--text-muted);">
            <div style="font-size: 3rem; margin-bottom: 0.5rem;">🔍</div>
            <h3>No culinary matches found</h3>
            <p>Try searching for a different dish or select another category above.</p>
          </div>
        `;
        return;
      }

      filtered.forEach(item => {
        const qty = cart[item.id] || 0;
        const card = document.createElement('div');
        card.className = 'food-card';
        card.setAttribute('data-tilt', '');
        card.setAttribute('data-tilt-max', '15');
        card.setAttribute('data-tilt-speed', '400');
        card.setAttribute('data-tilt-glare', '');
        card.setAttribute('data-tilt-max-glare', '0.2');
        card.setAttribute('data-tilt-scale', '1.03');

        const isVeg = isItemVegetarian(item);
        const vegIcon = isVeg
          ? `<span class="veg-indicator" title="100% Pure Vegetarian"><span class="dot"></span></span>`
          : `<span class="nonveg-indicator" title="Non-Vegetarian"><span class="dot"></span></span>`;

        // Quantity control or Add to Cart button
        const actionHtml = qty > 0 ? `
          <div class="qty-counter-pill">
            <button class="qty-counter-btn" onclick="updateItemQty(${item.id}, -1)">−</button>
            <span class="qty-counter-num">${qty}</span>
            <button class="qty-counter-btn" onclick="updateItemQty(${item.id}, 1)">+</button>
          </div>
        ` : `
          <button class="btn-add-cart" onclick="handleAddClick(this, ${item.id})">
            <span>+ Add</span>
          </button>
        `;

        card.innerHTML = `
          <div class="card-media">
            <img src="${item.imageUrl}" alt="${item.name}" loading="lazy" onerror="this.src='https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=600&auto=format&fit=crop&q=80'">
            ${item.badge ? `<span class="card-badge">${item.badge}</span>` : ''}
            <span class="card-category-tag">${item.category}</span>
          </div>
          <div class="card-body">
            <h3 class="card-title">${vegIcon}<span>${item.name}</span></h3>
            <p class="card-desc">${item.description}</p>
            <div class="card-footer">
              <div class="card-price"><span>₹</span>${item.price.toFixed(2)}</div>
              ${actionHtml}
            </div>
          </div>
        `;
        grid.appendChild(card);
      });

      animateMenuCardsOnRender();
    }

    /**
     * Tactile feedback on + Add button & Cart Update
     */
    function handleAddClick(button, itemId) {
      if (button) {
        button.classList.add('item-added-anim');
        const oldText = button.innerHTML;
        button.innerHTML = `<span>✓ Added</span>`;

        setTimeout(() => {
          button.classList.remove('item-added-anim');
          button.innerHTML = oldText;
        }, 450);
      }
      updateItemQty(itemId, 1, button);
    }

    /**
     * Staggers food cards with 3D elevation and binds interactive tilt
     */
    function animateMenuCardsOnRender() {
      if (typeof gsap !== 'undefined') {
        gsap.fromTo(
          '.food-card',
          { opacity: 0, y: 35, scale: 0.96 },
          {
            opacity: 1,
            y: 0,
            scale: 1,
            duration: 0.6,
            stagger: 0.05,
            ease: 'power2.out',
            clearProps: 'transform'
          }
        );
      }
      if (typeof ScrollTrigger !== 'undefined') {
        ScrollTrigger.refresh();
      }
      initCard3DTilt();
    }

    /**
     * Interactive 3D Card Hover Micro-Interactions (Vanilla-Tilt.js & Fallback)
     */
    function initCard3DTilt() {
      if (!window.matchMedia('(pointer: fine)').matches) return;
      const cards = document.querySelectorAll('.food-card');
      if (typeof VanillaTilt !== 'undefined') {
        VanillaTilt.init(cards, {
          max: 15,
          speed: 400,
          glare: true,
          "max-glare": 0.2,
          scale: 1.03,
          perspective: 1000
        });
      } else {
        cards.forEach(card => {
          card.addEventListener('mousemove', (e) => {
            const rect = card.getBoundingClientRect();
            const x = e.clientX - rect.left - rect.width / 2;
            const y = e.clientY - rect.top - rect.height / 2;
            const tiltX = (y / rect.height) * -8;
            const tiltY = (x / rect.width) * 8;
            card.style.transform = `translateY(-6px) perspective(1000px) rotateX(${tiltX}deg) rotateY(${tiltY}deg) scale3d(1.02, 1.02, 1.02)`;
          });
          card.addEventListener('mouseleave', () => {
            card.style.transform = '';
          });
        });
      }
    }

    /**
     * Category filtering
     */
    function filterCategory(cat) {
      currentCategory = cat;
      const pills = document.querySelectorAll('.pill-btn');
      pills.forEach(p => {
        if ((cat === 'All' && p.textContent.includes('All')) ||
            (cat !== 'All' && p.textContent.includes(cat))) {
          p.classList.add('active');
        } else {
          p.classList.remove('active');
        }
      });
      renderMenu();
    }

    /**
     * Live search handler
     */
    function handleSearch() {
      searchQuery = document.getElementById('searchInput').value.trim();
      renderMenu();
    }

    /**
     * Cart quantity modifier with tactile click feedback
     */
    function updateItemQty(itemId, delta, btnElement) {
      // Require registration / sign in before adding items to order list or cart
      if (delta > 0 && !currentUser) {
        pendingCartItem = { itemId, delta };
        const targetItem = menuItems.find(m => m.id === itemId);
        const itemName = targetItem ? targetItem.name : 'this item';
        openAuthModal('login');
        setAuthAlert(`Please sign in or create an account first to add "${itemName}" to your order list.`, false);
        return;
      }

      // Immediate tactile click animation / checkmark feedback
      if (delta > 0 && btnElement) {
        btnElement.classList.add('item-added-anim');
        btnElement.innerHTML = `<span>✓ Added</span>`;
      }

      const current = cart[itemId] || 0;
      const updated = current + delta;

      if (updated <= 0) {
        delete cart[itemId];
      } else {
        cart[itemId] = updated;
      }

      // Micro-delay if button was clicked to allow the tactile animation to be visible
      if (delta > 0 && btnElement) {
        setTimeout(() => {
          renderMenu();
          renderCart();
        }, 180);
      } else {
        renderMenu();
        renderCart();
      }
    }

    /**
     * Clears entire cart
     */
    function clearCart() {
      cart = {};
      renderMenu();
      renderCart();
    }

    /**
     * Computes cart financial breakdown & updates sidebar
     */
    function renderCart() {
      const listContainer = document.getElementById('cartItemsList');
      const checkoutBtn = document.getElementById('checkoutBtn');
      const navCartCount = document.getElementById('navCartCount');

      const itemIds = Object.keys(cart);
      let subtotal = 0;
      let totalCount = 0;

      listContainer.innerHTML = '';

      if (itemIds.length === 0) {
        listContainer.innerHTML = `
          <div class="cart-empty-state">
            <div class="icon">🍽️</div>
            <p>Your cart is empty.</p>
            <span style="font-size: 0.78rem; color: var(--text-subtle);">Select mouth-watering items from the menu to get started!</span>
          </div>
        `;
        document.getElementById('cartSubtotal').textContent = '₹0.00';
        document.getElementById('cartTax').textContent = '₹0.00';
        document.getElementById('cartDelivery').textContent = '₹0.00';
        document.getElementById('cartGrandTotal').textContent = '₹0.00';
        document.getElementById('deliveryProgressBar').style.width = '0%';
        document.getElementById('deliveryProgressMsg').textContent = `Add ₹${FREE_DELIVERY_THRESHOLD.toFixed(2)} for FREE Delivery`;
        document.getElementById('deliveryProgressPct').textContent = '0%';
        checkoutBtn.disabled = true;
        navCartCount.textContent = '0';
        return;
      }

      itemIds.forEach(idStr => {
        const id = parseInt(idStr, 10);
        const qty = cart[id];
        const item = menuItems.find(m => m.id === id);
        if (!item) return;

        const lineTotal = item.price * qty;
        subtotal += lineTotal;
        totalCount += qty;

        const row = document.createElement('div');
        row.className = 'cart-item-row';
        row.innerHTML = `
          <div class="cart-item-info">
            <div class="cart-item-name">${item.name}</div>
            <div class="cart-item-price">₹${item.price.toFixed(2)} each</div>
          </div>
          <div class="cart-item-actions">
            <div class="qty-counter-pill" style="transform: scale(0.9);">
              <button class="qty-counter-btn" onclick="updateItemQty(${item.id}, -1)">−</button>
              <span class="qty-counter-num">${qty}</span>
              <button class="qty-counter-btn" onclick="updateItemQty(${item.id}, 1)">+</button>
            </div>
            <div class="cart-item-subtotal">₹${lineTotal.toFixed(2)}</div>
          </div>
        `;
        listContainer.appendChild(row);
      });

      // Financial math
      const tax = subtotal * TAX_RATE;
      const isFreeDelivery = subtotal >= FREE_DELIVERY_THRESHOLD;
      const deliveryFee = isFreeDelivery ? 0.00 : STANDARD_DELIVERY_FEE;
      const grandTotal = subtotal + tax + deliveryFee;

      // Delivery progress bar
      const progressPercent = Math.min(100, Math.round((subtotal / FREE_DELIVERY_THRESHOLD) * 100));
      document.getElementById('deliveryProgressBar').style.width = `${progressPercent}%`;
      document.getElementById('deliveryProgressPct').textContent = `${progressPercent}%`;

      if (isFreeDelivery) {
        document.getElementById('deliveryProgressMsg').innerHTML = `🎉 <strong>You unlocked FREE Delivery!</strong>`;
      } else {
        const remaining = (FREE_DELIVERY_THRESHOLD - subtotal).toFixed(2);
        document.getElementById('deliveryProgressMsg').textContent = `Add ₹${remaining} more for FREE Delivery`;
      }

      // Update UI displays
      document.getElementById('cartSubtotal').textContent = `₹${subtotal.toFixed(2)}`;
      document.getElementById('cartTax').textContent = `₹${tax.toFixed(2)}`;
      document.getElementById('cartDelivery').textContent = isFreeDelivery ? 'FREE (₹0.00)' : `₹${deliveryFee.toFixed(2)}`;
      document.getElementById('cartGrandTotal').textContent = `₹${grandTotal.toFixed(2)}`;

      navCartCount.textContent = totalCount;
      checkoutBtn.disabled = false;
    }

    /**
     * Mobile cart drawer toggle
     */
    function toggleCartDrawer() {
      const sidebar = document.getElementById('cartSidebar');
      const overlay = document.getElementById('cartOverlay');
      sidebar.classList.toggle('open');
      overlay.classList.toggle('active');
    }

    /**
     * Opens checkout details modal (auto-filling logged in customer details)
     */
    function openCheckoutModal() {
      if (!currentUser) {
        openAuthModal('login');
        setAuthAlert('Please sign in or create an account first to proceed to checkout.', false);
        return;
      }

      const totalStr = document.getElementById('cartGrandTotal').textContent;
      document.getElementById('modalPayableTotal').textContent = totalStr;

      // Auto-fill logged-in customer's details
      if (currentUser.name) document.getElementById('custName').value = currentUser.name;
      if (currentUser.phone) document.getElementById('custPhone').value = currentUser.phone;
      if (currentUser.address) document.getElementById('custAddress').value = currentUser.address;

      openModal('checkoutModal');
    }

    /**
     * Payment method selection
     */
    function selectPayment(elem, method) {
      document.querySelectorAll('.payment-option-card').forEach(el => el.classList.remove('active'));
      elem.classList.add('active');
      selectedPaymentMethod = method;
    }

    /**
     * Submits order via POST /api/order
     */
    async function submitOrder(e) {
      if (e && e.preventDefault) e.preventDefault();
      const custName = document.getElementById('custName').value.trim();
      const custPhone = document.getElementById('custPhone').value.trim();
      const custAddress = document.getElementById('custAddress').value.trim();

      if (!custName || !custPhone || !custAddress) {
        alert('Please fill in all required fields (Name, Phone Number, and Delivery Address).');
        if (!custName) document.getElementById('custName').focus();
        else if (!custPhone) document.getElementById('custPhone').focus();
        else document.getElementById('custAddress').focus();
        return;
      }

      const submitBtn = document.getElementById('submitOrderBtn');
      submitBtn.disabled = true;
      submitBtn.innerHTML = `<span>Placing your order...</span>`;

      // Build payload matching C parser in server.c
      const payload = {
        username: currentUser ? currentUser.username : "guest",
        customerName: document.getElementById('custName').value.trim(),
        customerPhone: document.getElementById('custPhone').value.trim(),
        deliveryAddress: document.getElementById('custAddress').value.trim(),
        notes: document.getElementById('custNotes').value.trim(),
        paymentMethod: selectedPaymentMethod,
        items: Object.keys(cart).map(id => ({
          id: parseInt(id, 10),
          qty: cart[id]
        }))
      };

      try {
        const response = await fetch('/api/order', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        if (!response.ok) {
          throw new Error('Server returned error status: ' + response.status);
        }

        const invoice = await response.json();
        closeModal('checkoutModal');
        showInvoice(invoice);
        clearCart();
        refreshMyOrders();
      } catch (err) {
        console.error('Order submission error:', err);
        // If testing frontend directly without server running, create simulated invoice
        alert('Order received successfully (simulated demonstration mode).');
        const simulatedInvoice = {
          orderId: "ORD-" + new Date().toISOString().slice(0, 10).replace(/-/g, '') + "-9482",
          timestamp: new Date().toLocaleString(),
          status: "Confirmed",
          customer: {
            name: payload.customerName,
            phone: payload.customerPhone,
            address: payload.deliveryAddress
          },
          pricing: {
            subtotal: 27.49,
            tax: 1.37,
            deliveryFee: 2.99,
            total: 31.85
          },
          items: payload.items.map(it => {
            const m = menuItems.find(x => x.id === it.id) || { name: "Special Dish", price: 10.0 };
            return {
              name: m.name,
              quantity: it.qty,
              unitPrice: m.price,
              subtotal: m.price * it.qty
            };
          })
        };
        closeModal('checkoutModal');
        showInvoice(simulatedInvoice);
        clearCart();
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = `<span>Confirm & Place Order</span><span>⚡</span>`;
      }
    }

    /**
     * Renders confirmed invoice modal
     */
    function showInvoice(inv) {
      document.getElementById('invOrderId').textContent = inv.orderId;
      document.getElementById('invTimestamp').textContent = inv.timestamp;
      document.getElementById('invCustName').textContent = inv.customer.name;
      document.getElementById('invCustPhone').textContent = inv.customer.phone;
      document.getElementById('invCustAddress').textContent = inv.customer.address;

      const tbody = document.getElementById('invItemsBody');
      tbody.innerHTML = '';

      (inv.items || []).forEach(item => {
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td><strong>${item.name}</strong></td>
          <td style="text-align: center;">${item.quantity}</td>
          <td style="text-align: right;">₹${item.unitPrice.toFixed(2)}</td>
          <td style="text-align: right;"><strong>₹${item.subtotal.toFixed(2)}</strong></td>
        `;
        tbody.appendChild(tr);
      });

      document.getElementById('invSubtotal').textContent = `₹${inv.pricing.subtotal.toFixed(2)}`;
      document.getElementById('invTax').textContent = `₹${inv.pricing.tax.toFixed(2)}`;
      document.getElementById('invDelivery').textContent = inv.pricing.deliveryFee === 0 ? 'FREE' : `₹${inv.pricing.deliveryFee.toFixed(2)}`;
      document.getElementById('invGrandTotal').textContent = `₹${inv.pricing.total.toFixed(2)}`;

      openModal('invoiceModal');
    }

    /**
     * Modal display helpers
     */
    function openModal(id) {
      const modal = document.getElementById(id);
      if (modal) modal.classList.add('active');
    }

    function closeModal(id) {
      const modal = document.getElementById(id);
      if (modal) modal.classList.remove('active');
    }

    /* ======================================================================= */
    /* AUTHENTICATION & CUSTOMER ACCOUNT MANAGEMENT                            */
    /* ======================================================================= */

    /**
     * Updates top-right navbar based on current customer login state
     */
    function renderAuthUI() {
      const container = document.getElementById('authNavContainer');
      if (!container) return;

      if (!currentUser) {
        container.innerHTML = `
          <button class="btn-nav-signin" onclick="openAuthModal('login')" title="Sign In">
            <span>🔑</span> <span>Sign In</span>
          </button>
          <button class="btn-nav-signup" onclick="openAuthModal('signup')" title="Create Account">
            <span>✨</span> <span>Sign Up</span>
          </button>
        `;
      } else {
        const firstName = currentUser.name ? currentUser.name.split(' ')[0] : currentUser.username;
        const initial = firstName.charAt(0).toUpperCase();

        container.innerHTML = `
          <div class="user-pill-container">
            <button class="user-profile-pill" onclick="openMyOrdersModal()" title="View your personal order history">
              <span class="user-avatar-circle">${initial}</span>
              <span class="user-display-name">${firstName}</span>
              <span class="user-orders-tag">📦 My Orders</span>
            </button>
            <button class="btn-icon-square" onclick="logoutUser()" title="Sign Out (${currentUser.username})">
              🚪
            </button>
          </div>
        `;
      }
    }

    /**
     * Opens authentication modal with specified active tab
     */
    function openAuthModal(tab) {
      clearAuthAlert();
      switchAuthTab(tab);
      openModal('authModal');
    }

    /**
     * Switches between Sign In and Sign Up tabs in auth modal
     */
    function switchAuthTab(tab) {
      clearAuthAlert();
      const loginForm = document.getElementById('loginForm');
      const signupForm = document.getElementById('signupForm');
      const tabLogin = document.getElementById('tabBtnLogin');
      const tabSignup = document.getElementById('tabBtnSignup');
      const title = document.getElementById('authModalTitle');
      const subtitle = document.getElementById('authModalSubtitle');

      if (tab === 'login') {
        loginForm.style.display = 'block';
        signupForm.style.display = 'none';
        tabLogin.classList.add('active');
        tabSignup.classList.remove('active');
        title.textContent = 'Welcome Back';
        subtitle.textContent = 'Sign in to access and track your personal order history.';
      } else {
        loginForm.style.display = 'none';
        signupForm.style.display = 'block';
        tabLogin.classList.remove('active');
        tabSignup.classList.add('active');
        title.textContent = 'Create Customer Account';
        subtitle.textContent = 'Register to save delivery addresses and track orders in real-time.';
      }
    }


    /**
     * Sets notification banner in auth modal
     */
    function setAuthAlert(msg, isError) {
      const banner = document.getElementById('authAlertBanner');
      banner.style.display = 'block';
      banner.textContent = msg;
      if (isError) {
        banner.style.background = 'rgba(239, 68, 68, 0.15)';
        banner.style.color = '#f87171';
        banner.style.border = '1px solid rgba(239, 68, 68, 0.3)';
      } else {
        banner.style.background = 'rgba(0, 255, 136, 0.15)';
        banner.style.color = '#00ff88';
        banner.style.border = '1px solid rgba(0, 255, 136, 0.35)';
      }
    }

    function clearAuthAlert() {
      const banner = document.getElementById('authAlertBanner');
      if (banner) banner.style.display = 'none';
    }

    /**
     * Handles customer Login form submission (POST /api/login)
     */
    async function handleLoginSubmit(e) {
      e.preventDefault();
      const btn = document.getElementById('loginSubmitBtn');
      btn.disabled = true;
      btn.innerHTML = `<span>Signing in...</span>`;
      clearAuthAlert();

      const username = document.getElementById('loginUsername').value.trim();
      const password = document.getElementById('loginPassword').value.trim();

      try {
        const response = await fetch('/api/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username, password })
        });

        const data = await response.json();

        if (!response.ok || !data.success) {
          throw new Error(data.error || 'Authentication failed. Please verify credentials.');
        }

        // Save session
        currentUser = data.user;
        localStorage.setItem('bitecraft_user', JSON.stringify(currentUser));
        renderAuthUI();
        closeModal('authModal');

        // If user was prompted to login while adding an item to their order/cart, add it now
        if (pendingCartItem) {
          const itemToAdd = pendingCartItem;
          pendingCartItem = null;
          updateItemQty(itemToAdd.itemId, itemToAdd.delta);
          if (window.innerWidth <= 1024) {
            const sidebar = document.getElementById('cartSidebar');
            if (sidebar && !sidebar.classList.contains('open')) {
              toggleCartDrawer();
            }
          }
        } else {
          openMyOrdersModal();
        }
      } catch (err) {
        setAuthAlert(err.message, true);
      } finally {
        btn.disabled = false;
        btn.innerHTML = `<span>Sign In &amp; Track Orders</span><span>&rarr;</span>`;
      }
    }

    /**
     * Handles customer Sign Up form submission (POST /api/signup)
     */
    async function handleSignupSubmit(e) {
      e.preventDefault();
      const btn = document.getElementById('signupSubmitBtn');
      btn.disabled = true;
      btn.innerHTML = `<span>Creating account...</span>`;
      clearAuthAlert();

      const payload = {
        name: document.getElementById('signupName').value.trim(),
        username: document.getElementById('signupUsername').value.trim(),
        password: document.getElementById('signupPassword').value.trim(),
        phone: document.getElementById('signupPhone').value.trim(),
        address: document.getElementById('signupAddress').value.trim()
      };

      try {
        const response = await fetch('/api/signup', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data = await response.json();

        if (!response.ok || !data.success) {
          throw new Error(data.error || 'Failed to register account.');
        }

        // Save session
        currentUser = data.user;
        localStorage.setItem('bitecraft_user', JSON.stringify(currentUser));
        renderAuthUI();
        closeModal('authModal');

        // If user was prompted to sign up while adding an item to their order/cart, add it now
        if (pendingCartItem) {
          const itemToAdd = pendingCartItem;
          pendingCartItem = null;
          updateItemQty(itemToAdd.itemId, itemToAdd.delta);
          if (window.innerWidth <= 1024) {
            const sidebar = document.getElementById('cartSidebar');
            if (sidebar && !sidebar.classList.contains('open')) {
              toggleCartDrawer();
            }
          }
        } else {
          openMyOrdersModal();
        }
      } catch (err) {
        setAuthAlert(err.message, true);
      } finally {
        btn.disabled = false;
        btn.innerHTML = `<span>Create Account &amp; Continue</span><span>✨</span>`;
      }
    }

    /**
     * Signs out current customer
     */
    function logoutUser() {
      currentUser = null;
      localStorage.removeItem('bitecraft_user');
      renderAuthUI();
      closeModal('myOrdersModal');
    }

    /**
     * Opens the personal orders modal for the logged-in customer
     */
    function openMyOrdersModal() {
      if (!currentUser) {
        openAuthModal('login');
        return;
      }
      openModal('myOrdersModal');
      refreshMyOrders();
    }

    /**
     * Fetches and renders orders belonging exclusively to the current customer
     */
    async function refreshMyOrders() {
      if (!currentUser) return;
      const container = document.getElementById('userOrdersList');
      const subtitle = document.getElementById('myOrdersSubtitle');
      subtitle.textContent = `Showing verified orders for ${currentUser.name || currentUser.username} (@${currentUser.username})`;
      container.innerHTML = `<p style="color: var(--text-muted); text-align: center; padding: 2.5rem 1rem;">Fetching your orders...</p>`;

      try {
        const res = await fetch(`/api/user/orders?username=${encodeURIComponent(currentUser.username)}`);
        if (!res.ok) throw new Error('Failed to retrieve personal orders');
        const data = await res.json();
        const orders = data.orders || [];

        if (orders.length === 0) {
          container.innerHTML = `
            <div style="text-align: center; padding: 3rem 1rem; color: var(--text-muted);">
              <div style="font-size: 3rem; margin-bottom: 0.5rem; opacity: 0.7;">📦</div>
              <h4 style="color: #fff; font-size: 1.1rem; margin-bottom: 0.35rem;">No orders placed yet</h4>
              <p style="font-size: 0.85rem; max-width: 320px; margin: 0 auto 1.25rem;">
                Explore our gourmet menu and add your favorite dishes to place your first order!
              </p>
              <button class="btn-checkout" style="max-width: 220px; margin: 0 auto; padding: 0.65rem 1rem;" onclick="closeModal('myOrdersModal')">
                Browse Menu
              </button>
            </div>
          `;
          return;
        }

        container.innerHTML = '';
        orders.slice().reverse().forEach(ord => {
          const card = document.createElement('div');
          card.className = 'user-order-card';
          card.innerHTML = `
            <div class="user-order-header">
              <div>
                <span class="user-order-id">${ord.orderId}</span>
                <span style="font-size: 0.75rem; color: var(--text-subtle); margin-left: 0.5rem;">${ord.timestamp}</span>
              </div>
              <span class="user-order-status-badge">
                <span style="width: 6px; height: 6px; border-radius: 50%; background: var(--secondary);"></span>
                ${ord.status}
              </span>
            </div>
            <div class="user-order-details">
              <strong>Items:</strong> ${ord.items || 'Gourmet meal selections'}
            </div>
            <div class="user-order-footer">
              <div class="user-order-total">
                Total: <span>₹${ord.total}</span>
              </div>
              <button class="btn-icon-outline" style="padding: 0.35rem 0.75rem; font-size: 0.78rem;" onclick="window.print()">
                🖨️ Receipt
              </button>
            </div>
          `;
          container.appendChild(card);
        });

      } catch (err) {
        container.innerHTML = `
          <div style="text-align: center; padding: 2rem; color: #f87171;">
            <p>Failed to load orders: ${err.message}</p>
          </div>
        `;
      }
    }
  </script>

  <!-- ========================================================================= -->
  <!-- LENIS SMOOTH SCROLL, GSAP SCROLLTRIGGER & VANILLA TILT INITIALIZATION     -->
  <!-- ========================================================================= -->
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      // 1. Initialize Lenis Smooth Scroll
      const lenis = new Lenis({
        duration: 1.2,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)), // smooth exponential easing
        smoothWheel: true,
      });

      window.lenis = lenis;

      // Synchronize Lenis scrolling with GSAP's ScrollTrigger
      lenis.on('scroll', ScrollTrigger.update);
      lenis.on('scroll', updateScrollStates);

      gsap.ticker.add((time) => {
        lenis.raf(time * 1000);
      });
      gsap.ticker.lagSmoothing(0);

      // 2. GSAP ScrollTrigger Animations (Fade up and parallax floating)
      // Fade up headings and sections on scroll
      gsap.utils.toArray('.animate-on-scroll').forEach((element) => {
        gsap.fromTo(element, 
          { opacity: 0, y: 50 }, 
          {
            opacity: 1,
            y: 0,
            duration: 1,
            ease: 'power3.out',
            scrollTrigger: {
              trigger: element,
              start: 'top 85%',
              toggleActions: 'play none none reverse',
            }
          }
        );
      });

      // Parallax floating effect for food elements (burgers, pizza, tomatoes)
      gsap.utils.toArray('.floating-food').forEach((item, index) => {
        const speed = (index + 1) * 30; // Different speeds for depth
        gsap.to(item, {
          y: -speed,
          scrollTrigger: {
            trigger: item,
            start: 'top bottom',
            end: 'bottom top',
            scrub: true, // Smooth scrub linked directly to scroll
          }
        });
      });

      // 3. Initialize Vanilla-Tilt.js for 3D Card Hover Effects
      VanillaTilt.init(document.querySelectorAll(".food-card"), {
        max: 15,          // Max tilt angle
        speed: 400,       // Enter/exit transition speed
        glare: true,      // Adds a subtle glass reflection
        "max-glare": 0.2, // Glare intensity
        scale: 1.03       // Slight zoom on hover
      });
    });
  </script>
</body>

</html>