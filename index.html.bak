        <button type="submit" class="btn-checkout" id="loginSubmitBtn">
          <span>Sign In &amp; Track Orders</span>
          <span>&rarr;</span>
        </button>
      </form>

      <!-- Sign Up Form -->
      <form id="signupForm" style="display: none;" onsubmit="handleSignupSubmit(event)">
        <div class="form-group">
          <label class="form-label" for="signupName">Full Name *</label>
          <input type="text" id="signupName" class="form-input" placeholder="e.g. Marcus Vance" required>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="signupUsername">Username *</label>
            <input type="text" id="signupUsername" class="form-input" placeholder="e.g. marcus" required
              autocomplete="username">
          </div>
          <div class="form-group">
            <label class="form-label" for="signupPassword">Password *</label>
            <input type="password" id="signupPassword" class="form-input" placeholder="Min. 4 chars" required
              minlength="4" autocomplete="new-password">
          </div>
        </div>
        <div class="form-group">
          <label class="form-label" for="signupPhone">Phone Number *</label>
          <input type="tel" id="signupPhone" class="form-input" placeholder="e.g. +1 (555) 321-4321" required>
        </div>
        <div class="form-group">
          <label class="form-label" for="signupAddress">Delivery Address *</label>
          <input type="text" id="signupAddress" class="form-input" placeholder="Street address, apartment, suite"
            required>
        </div>
        <button type="submit" class="btn-checkout" id="signupSubmitBtn">
          <span>Create Account &amp; Continue</span>
          <span>✨</span>
        </button>
      </form>
    </div>
  </div>

  <!-- ======================================================================= -->
  <!-- CUSTOMER PERSONAL ORDERS MODAL                                          -->
  <!-- ======================================================================= -->
  <div class="modal-backdrop" id="myOrdersModal">
    <div class="modal-card" style="max-width: 650px;">
      <button class="modal-close-btn" onclick="closeModal('myOrdersModal')">&times;</button>

      <div class="modal-header">
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;">
          <div>
            <h3 class="modal-title">My Orders</h3>
            <p class="modal-subtitle" id="myOrdersSubtitle">Track your personal orders and real-time kitchen status</p>
          </div>
          <button class="btn-icon-outline" style="padding: 0.35rem 0.75rem; font-size: 0.78rem;"
            onclick="refreshMyOrders()">
            🔄 Refresh
          </button>
        </div>
      </div>

      <!-- Orders List Container -->
      <div id="userOrdersList" style="max-height: 480px; overflow-y: auto; padding-right: 0.3rem;">
        <p style="color: var(--text-muted); text-align: center; padding: 2rem;">Loading your orders...</p>
      </div>
    </div>
  </div>

  <!-- ======================================================================= -->
  <!-- JAVASCRIPT: CLIENT CORE & C API CONNECTIONS                             -->
  <!-- ======================================================================= -->
  <script>
    // State management
    let menuItems = [];
    let currentCategory = 'All';
    let searchQuery = '';
    let cart = {}; // { itemId: quantity }
    let selectedPaymentMethod = 'COD';
    let currentUser = null;
    let pendingCartItem = null; // { itemId, delta } queued when unauthenticated user adds item

    // Free delivery threshold & tax constant matching server.h
    const TAX_RATE = 0.05;
    const FREE_DELIVERY_THRESHOLD = 199.00;
    const STANDARD_DELIVERY_FEE = 29.00;

    // Initialize application on load
    document.addEventListener('DOMContentLoaded', () => {
      // Restore persisted session from localStorage if available
      try {
        const savedUser = localStorage.getItem('bitecraft_user');
        if (savedUser) {
          currentUser = JSON.parse(savedUser);
        }
      } catch (e) {
        console.warn('Error reading saved user session:', e);
      }

      initLenis();
      renderAuthUI();
      fetchMenu();
      initScrollAnimations();
      updateScrollStates();
    });

    /**
     * Smoothly scrolls to the food menu items section below the landing hero
     */
    function scrollToMenu() {
      const menuSection = document.getElementById('menuSection');
      if (!menuSection) return;

      if (window.lenis) {
        window.lenis.scrollTo(menuSection, {
          offset: -65,
          duration: 1.3,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t))
        });
      } else {
        const navHeight = 68;
        const targetPos = menuSection.getBoundingClientRect().top + window.pageYOffset - navHeight;
        window.scrollTo({
          top: targetPos,
          behavior: 'smooth'
        });
      }
    }

    /**
     * Smoothly scrolls to top of page
     */
    function scrollToTop() {
      if (window.lenis) {
        window.lenis.scrollTo(0, {
          duration: 1.2,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t))
        });
      } else {
        window.scrollTo({
          top: 0,
          behavior: 'smooth'
        });
      }
    }

    /**
     * Passive Scroll Handler: Navbar Glassmorphism, Progress Bar, Back-To-Top Button
     */
    function updateScrollStates() {
      const scrollY = window.pageYOffset || document.documentElement.scrollTop;

      // 1. Top Navbar transition:
      // Sleek semi-transparent glassmorphism while user is in the hero section.
      // Smoothly transitions to solid/semi-opaque backdrop once scrolled past the hero section.
      const navbar = document.getElementById('topNavbar');
      if (navbar) {
        const heroSection = document.getElementById('landingHero');
        // Threshold: when scroll passes the hero section height (minus navbar height)
        const heroThreshold = heroSection ? Math.max(300, heroSection.offsetHeight - 90) : 550;
        if (scrollY >= heroThreshold) {
          navbar.classList.add('scrolled');
        } else {
          navbar.classList.remove('scrolled');
        }
      }

      // 2. Top Scroll Progress Indicator Bar
      const progressBar = document.getElementById('scrollProgressBar');
      if (progressBar) {
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const pct = docHeight > 0 ? (scrollY / docHeight) * 100 : 0;
        progressBar.style.width = `${pct}%`;
      }

      // 3. Back-to-top button visibility
      const backToTop = document.getElementById('backToTopBtn');
      if (backToTop) {
        if (scrollY > 480) {
          backToTop.classList.add('visible');
        } else {
          backToTop.classList.remove('visible');
        }
      }
    }

    window.addEventListener('scroll', updateScrollStates, { passive: true });

    /**
     * =========================================================================
     * SMOOTH SCROLL ENGINE (Lenis v1.1.18 + GSAP ScrollTrigger Integration)
     * High-End Inertia Scroll (Zero-Lag, Synchronized Ticker Loop)
     * =========================================================================
     */
    function initLenis() {
      if (typeof Lenis === 'undefined' || window.lenis) return;

      const lenis = new Lenis({
        duration: 1.25,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        orientation: 'vertical',
        gestureOrientation: 'vertical',
        smoothWheel: true,
        wheelMultiplier: 1,
        touchMultiplier: 1.5,
        infinite: false,
      });

      window.lenis = lenis;

      // Synchronize Lenis scroll updates with GSAP ScrollTrigger
      if (typeof ScrollTrigger !== 'undefined') {
        lenis.on('scroll', ScrollTrigger.update);

        gsap.ticker.add((time) => {
          lenis.raf(time * 1000);
        });

        gsap.ticker.lagSmoothing(0);
      } else {
        function raf(time) {
          lenis.raf(time);
          requestAnimationFrame(raf);
        }
        requestAnimationFrame(raf);
      }

      // Sync passive scroll states with Lenis scroll output
      lenis.on('scroll', updateScrollStates);
    }

    /**
     * =========================================================================
     * PROFESSIONAL NATIVE SCROLL ANIMATION SUITE (GSAP ScrollTrigger)
     * High Performance, 100% Reliable Native Scroll Engine
     * =========================================================================
     */
    function initScrollAnimations() {
      if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') {
        return;
      }

      gsap.registerPlugin(ScrollTrigger);

      // 1. Hero Content Smooth Scale & Fade on Scroll Scrub
      gsap.to('.zomato-hero-content', {
        scrollTrigger: {
          trigger: '#landingHero',
          start: 'top top',
          end: 'bottom top',
          scrub: true,
        },
        y: -90,
        scale: 0.9,
        opacity: 0,
        ease: 'none',
      });

      // 2. Hero Background Camera Pan/Zoom
      gsap.to('.zomato-hero-bg', {
        scrollTrigger: {
          trigger: '#landingHero',
          start: 'top top',
          end: 'bottom top',
          scrub: true,
        },
        scale: 1.15,
        yPercent: 12,
        ease: 'none',
      });

      // 3. 3D Floating Food Ingredients Parallax Explosion
      const parallaxItems = document.querySelectorAll('.parallax-food-item');
      parallaxItems.forEach((item) => {
        const speed = parseFloat(item.getAttribute('data-speed')) || 0.35;
        const rot = parseFloat(item.getAttribute('data-rotate')) || 25;
        gsap.to(item, {
          scrollTrigger: {
            trigger: '#landingHero',
            start: 'top top',
            end: 'bottom top',
            scrub: true,
          },
          y: speed * 350,
          x: speed * 120,
          rotation: rot * 2,
          scale: 1 + Math.abs(speed) * 0.4,
          ease: 'none',
        });
      });

      // 4. Running Marquee Velocity Scrub (speeds up with scrolling)
      const marqueeTrack = document.getElementById('marqueeTrack');
      if (marqueeTrack) {
        ScrollTrigger.create({
          onUpdate: (self) => {
            const velocity = Math.abs(self.getVelocity());
            const boost = Math.min(22, velocity / 100);
            marqueeTrack.style.animationDuration = `${Math.max(6, 30 - boost)}s`;
          }
        });
      }

      // 5. "Better Food For More People" Mission Section Reveal & Scrubbed Parallax
      if (document.getElementById('missionSection')) {
        // Scrubbed text reveal
        gsap.fromTo('.mission-headline',
          { y: 80, opacity: 0, scale: 0.9 },
          {
            scrollTrigger: {
              trigger: '#missionSection',
              start: 'top 85%',
              end: 'top 40%',
              scrub: 1.2,
            },
            y: 0,
            opacity: 1,
            scale: 1,
            ease: 'power2.out',
          }
        );

        gsap.fromTo('.mission-subtext',
          { y: 50, opacity: 0 },
          {
            scrollTrigger: {
              trigger: '#missionSection',
              start: 'top 75%',
              end: 'top 35%',
              scrub: 1.2,
            },
            y: 0,
            opacity: 1,
            ease: 'power2.out',
          }
        );

        gsap.fromTo('.mission-badge-pill, .mission-cta-wrap',
          { opacity: 0, y: 30 },
          {
            scrollTrigger: {
              trigger: '#missionSection',
              start: 'top 80%',
              toggleActions: 'play none none reverse',
            },
            opacity: 1,
            y: 0,
            duration: 0.8,
            stagger: 0.15,
            ease: 'power2.out',
          }
        );

        // Scrubbed pink vector trail drawing
        gsap.fromTo('.mission-trail-svg .trail-path',
          { strokeDashoffset: 1400 },
          {
            scrollTrigger: {
              trigger: '#missionSection',
              start: 'top 80%',
              end: 'bottom 40%',
              scrub: 1.5,
            },
            strokeDashoffset: 0,
            ease: 'none',
          }
        );

        // Multi-axis floating food parallax scrub
        const missionFoods = document.querySelectorAll('#missionSection .floating-food-wrapper');
        missionFoods.forEach((item) => {
          const speed = parseFloat(item.getAttribute('data-speed')) || 0.35;
          const rot = parseFloat(item.getAttribute('data-rotate')) || 20;

          // Scrubbed entrance & drift
          gsap.fromTo(item,
            { y: speed * -120, rotation: rot * -0.5, opacity: 0.6 },
            {
              scrollTrigger: {
                trigger: '#missionSection',
                start: 'top bottom',
                end: 'bottom top',
                scrub: 1.2,
              },
              y: speed * 220,
              x: speed * 40,
              rotation: rot,
              opacity: 1,
              ease: 'none',
            }
          );
        });

        // Interactive Anti-Gravity Mouse Parallax (Henrietta snack feel)
        const missionSec = document.getElementById('missionSection');
        if (missionSec && window.matchMedia('(pointer: fine)').matches) {
          missionSec.addEventListener('mousemove', (e) => {
            const rect = missionSec.getBoundingClientRect();
            const relX = (e.clientX - rect.left) / rect.width - 0.5;
            const relY = (e.clientY - rect.top) / rect.height - 0.5;

            missionFoods.forEach((item) => {
              const speed = parseFloat(item.getAttribute('data-speed')) || 0.3;
              gsap.to(item.querySelector('.food-img-card') || item, {
                x: relX * speed * 70,
                y: relY * speed * 60,
                rotationX: -relY * 15,
                rotationY: relX * 15,
                duration: 0.7,
                ease: 'power1.out',
                overwrite: 'auto',
              });
            });
          });

          missionSec.addEventListener('mouseleave', () => {
            missionFoods.forEach((item) => {
              gsap.to(item.querySelector('.food-img-card') || item, {
                x: 0,
                y: 0,
                rotationX: 0,
                rotationY: 0,
                duration: 0.9,
                ease: 'power2.out',
              });
            });
          });
        }
      }

      // 6. Section headings reveal (GSAP ScrollTrigger)
      gsap.from(['.section-header', '.menu-section-header'], {
        scrollTrigger: {
          trigger: '#menuSection',
          start: 'top 85%',
          toggleActions: 'play none none reverse',
        },
        y: 40,
        opacity: 0,
        duration: 0.8,
        ease: 'power3.out',
      });

      // 6. Food Cards Staggered Scroll Entrance
      gsap.from('.food-card', {
        scrollTrigger: {
          trigger: '.menu-grid',
          start: 'top 80%',
          toggleActions: 'play none none reverse'
        },
        y: 45,
        opacity: 0,
        scale: 0.95,
        duration: 0.6,
        stagger: 0.08,
        ease: 'power2.out',
        clearProps: 'transform' // Preserves 3D tilt after scroll-in
      });

      // 7. Controls wrapper reveal
      gsap.from('.controls-wrapper', {
        scrollTrigger: {
          trigger: '.controls-wrapper',
          start: 'top 90%',
          toggleActions: 'play none none reverse',
        },
        y: 35,
        opacity: 0,
        duration: 0.75,
        ease: 'power3.out',
      });

      // 8. Initialize AOS if loaded
      if (typeof AOS !== 'undefined') {
        AOS.init({
          duration: 800,
          easing: 'ease-out-cubic',
          once: true,
          offset: 100
        });
      }
    }

    /**
     * Fetches food catalog from endpoint GET /api/menu
     */
    async function fetchMenu() {
      try {
        const response = await fetch('/api/menu');
        if (!response.ok) throw new Error('Network error fetching menu');
        const data = await response.json();
        menuItems = data.items || [];
        renderMenu();
      } catch (err) {
        console.warn('API fetch failed or offline, rendering fallback dataset:', err);
        // Fallback default dataset for offline preview (10x price updated)
        menuItems = [
          {
            id: 1,
            name: "Truffle Smash Burger",
            category: "Fast Food",
