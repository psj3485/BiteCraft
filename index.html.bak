        </div>
      </div>

      <div class="invoice-id-box">
        <div>
          <div style="font-size: 0.75rem; color: var(--text-subtle); text-transform: uppercase;">Order Number</div>
          <strong id="invOrderId">ORD-20261022-0000</strong>
        </div>
        <div style="text-align: right;">
          <div style="font-size: 0.75rem; color: var(--text-subtle); text-transform: uppercase;">Date &amp; Time</div>
          <div id="invTimestamp" style="font-size: 0.85rem; color: var(--text-muted); font-weight: 600;">2026-10-22
          </div>
        </div>
      </div>

      <!-- Customer Summary -->
      <div
        style="background: var(--bg-card); border-radius: var(--radius-md); padding: 0.9rem; margin-bottom: 1.25rem; font-size: 0.83rem;">
        <div style="color: var(--text-subtle); margin-bottom: 0.2rem;">DELIVERING TO:</div>
        <strong id="invCustName" style="color: #fff; font-size: 0.95rem;">Customer Name</strong>
        <div id="invCustPhone" style="color: var(--text-muted);">+91 00000 00000</div>
        <div id="invCustAddress" style="color: var(--text-muted); margin-top: 0.2rem;">Address</div>
      </div>

      <!-- Itemized Table -->
      <table class="invoice-items-table">
        <thead>
          <tr>
            <th>Item</th>
            <th style="text-align: center;">Qty</th>
            <th style="text-align: right;">Price</th>
            <th style="text-align: right;">Total</th>
          </tr>
        </thead>
        <tbody id="invItemsBody">
          <!-- Injected dynamically -->
        </tbody>
      </table>

      <!-- Pricing Summary Breakdown -->
      <div class="cart-bill-summary" style="margin-bottom: 1.5rem;">
        <div class="bill-row">
          <span>Items Subtotal</span>
          <span id="invSubtotal">₹0.00</span>
        </div>
        <div class="bill-row">
          <span>Estimated GST (5%)</span>
          <span id="invTax">₹0.00</span>
        </div>
        <div class="bill-row">
          <span>Delivery Charge</span>
          <span id="invDelivery">₹0.00</span>
        </div>
        <div class="bill-row grand-total">
          <span>Final Total Paid</span>
          <span class="amount" id="invGrandTotal">₹0.00</span>
        </div>
      </div>

      <div style="display: flex; gap: 0.75rem;">
        <button class="btn-icon-outline btn-print" style="flex: 1;" onclick="window.print()">
          🖨️ Print Invoice
        </button>
        <button class="btn-checkout btn-done" style="flex: 1; margin-top: 0;" onclick="closeModal('invoiceModal')">
          Done &amp; Order More
        </button>
      </div>
    </div>
  </div>

  <!-- ======================================================================= -->
  <!-- SIGN IN & SIGN UP MODAL                                                 -->
  <!-- ======================================================================= -->
  <div class="modal-backdrop" id="authModal">
    <div class="modal-card" style="max-width: 480px;">
      <button class="modal-close-btn" onclick="closeModal('authModal')">&times;</button>

      <div class="modal-header">
        <h3 class="modal-title" id="authModalTitle">Welcome to BiteCraft</h3>
        <p class="modal-subtitle" id="authModalSubtitle">Sign in or create an account to track your orders in real-time.
        </p>
      </div>

      <!-- Tab Buttons -->
      <div class="auth-tabs">
        <button type="button" class="auth-tab-btn active" id="tabBtnLogin" onclick="switchAuthTab('login')">Sign
          In</button>
        <button type="button" class="auth-tab-btn" id="tabBtnSignup" onclick="switchAuthTab('signup')">Create
          Account</button>
